@inherits LayoutComponentBase
@implements IDisposable
@inject FleetApiClient Api
@inject NavigationManager Nav

<div class="app-shell">
    <aside class="app-sidebar @(_sidebarOpen ? "open" : "") @(_sidebarCollapsed ? "collapsed" : "")">
        <div class="sidebar-brand">
            <a href="/" class="sidebar-brand-link" title="Go to dashboard">
                @if (_companyLogoUrl is not null)
                {
                    <img src="@_companyLogoUrl" alt="@_companyName" class="sidebar-logo" />
                }
                else
                {
                    <i class="bi bi-truck sidebar-logo-icon"></i>
                }
                <div class="sidebar-brand-text">
                    <div class="company-name">@(_companyName ?? "My Transport Company")</div>
                    <div class="system-name">Transportation Management System</div>
                </div>
            </a>
            <button class="sidebar-close d-lg-none" type="button" @onclick="CloseSidebar" aria-label="Close menu">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-module">
                <a class="nav-module-header @SubLinkClass("/")" href="/" title="Home">
                    <i class="bi bi-house-door"></i> <span class="nav-text">Home</span>
                </a>
            </div>

            <div class="nav-section-label">Modules</div>

            <div class="nav-module">
                <div class="nav-module-header active-module" title="Fleet Management">
                    <i class="bi bi-truck"></i> <span class="nav-text">Fleet Management</span>
                </div>
                <a class="nav-sublink @SubLinkClass("/fleet-vehicles")" href="/fleet-vehicles" title="Fleet Master">
                    <i class="bi bi-list-ul"></i> <span class="nav-text">Fleet Master</span>
                </a>
            </div>

            <div class="nav-module">
                <div class="nav-module-header @(SubLinkClass("/drivers") == "active" ? "active-module" : "")" title="Driver Management">
                    <i class="bi bi-person-badge"></i> <span class="nav-text">Driver Management</span>
                </div>
                <a class="nav-sublink @SubLinkClass("/drivers")" href="/drivers" title="Driver Master">
                    <i class="bi bi-list-ul"></i> <span class="nav-text">Driver Master</span>
                </a>
            </div>

            <div class="nav-module">
                <div class="nav-module-header @(SubLinkClass("/customers") == "active" ? "active-module" : "")" title="Customer Management">
                    <i class="bi bi-people"></i> <span class="nav-text">Customer Management</span>
                </div>
                <a class="nav-sublink @SubLinkClass("/customers")" href="/customers" title="Customer Master">
                    <i class="bi bi-list-ul"></i> <span class="nav-text">Customer Master</span>
                </a>
            </div>

            <div class="nav-module">
                <div class="nav-module-header @(SubLinkClass("/trips") == "active" ? "active-module" : "")" title="Trip / Booking">
                    <i class="bi bi-calendar-check"></i> <span class="nav-text">Trip / Booking</span>
                </div>
                <a class="nav-sublink @SubLinkClass("/trips")" href="/trips" title="Trip List">
                    <i class="bi bi-list-ul"></i> <span class="nav-text">Trip List</span>
                </a>
            </div>

            <div class="nav-module">
                <div class="nav-module-header @(SubLinkClass("/fuel-entries") == "active" ? "active-module" : "")" title="Fuel Management">
                    <i class="bi bi-fuel-pump"></i> <span class="nav-text">Fuel Management</span>
                </div>
                <a class="nav-sublink @SubLinkClass("/fuel-entries")" href="/fuel-entries" title="Fuel Log">
                    <i class="bi bi-list-ul"></i> <span class="nav-text">Fuel Log</span>
                </a>
            </div>

            <div class="nav-module">
                <div class="nav-module-header @(SubLinkClass("/workorders") == "active" ? "active-module" : "")" title="Maintenance &amp; Workshop">
                    <i class="bi bi-tools"></i> <span class="nav-text">Maintenance &amp; Workshop</span>
                </div>
                <a class="nav-sublink @SubLinkClass("/workorders")" href="/workorders" title="Work Orders">
                    <i class="bi bi-list-ul"></i> <span class="nav-text">Work Orders</span>
                </a>
            </div>

            <div class="nav-module">
                <div class="nav-module-header @(SubLinkClass("/invoices") == "active" ? "active-module" : "")" title="Billing &amp; Invoicing">
                    <i class="bi bi-receipt"></i> <span class="nav-text">Billing &amp; Invoicing</span>
                </div>
                <a class="nav-sublink @SubLinkClass("/invoices")" href="/invoices" title="Invoices">
                    <i class="bi bi-list-ul"></i> <span class="nav-text">Invoices</span>
                </a>
            </div>

            <div class="nav-module">
                <div class="nav-module-header @(SubLinkClass("/tyres") == "active" ? "active-module" : "")" title="Tyre Management">
                    <i class="bi bi-circle"></i> <span class="nav-text">Tyre Management</span>
                </div>
                <a class="nav-sublink @SubLinkClass("/tyres")" href="/tyres" title="Tyre List">
                    <i class="bi bi-list-ul"></i> <span class="nav-text">Tyre List</span>
                </a>
            </div>

            <div class="nav-module">
                <div class="nav-module-header @(SubLinkClass("/compliance") == "active" ? "active-module" : "")" title="Compliance">
                    <i class="bi bi-shield-check"></i> <span class="nav-text">Compliance</span>
                </div>
                <a class="nav-sublink @SubLinkClass("/compliance")" href="/compliance" title="Expiry Tracker">
                    <i class="bi bi-calendar-x"></i> <span class="nav-text">Expiry Tracker</span>
                </a>
                <a class="nav-sublink @SubLinkClass("/compliance/alert-settings")" href="/compliance/alert-settings" title="Alert Settings">
                    <i class="bi bi-bell"></i> <span class="nav-text">Alert Settings</span>
                </a>
            </div>

            <div class="nav-module">
                <div class="nav-module-header @(SubLinkClass("/reports") == "active" ? "active-module" : "")" title="Reports &amp; Analytics">
                    <i class="bi bi-bar-chart"></i> <span class="nav-text">Reports &amp; Analytics</span>
                </div>
                <a class="nav-sublink @SubLinkClass("/reports")" href="/reports" title="Reports Overview">
                    <i class="bi bi-graph-up"></i> <span class="nav-text">Reports Overview</span>
                </a>
            </div>

            <div class="nav-section-label mt-3">Settings</div>
            <div class="nav-module">
                <a class="nav-sublink @SubLinkClass("/settings/company")" href="/settings/company" title="Company Profile">
                    <i class="bi bi-building"></i> <span class="nav-text">Company Profile</span>
                </a>
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <a class="nav-sublink @SubLinkClass("/settings/users")" href="/settings/users" title="Users">
                            <i class="bi bi-people"></i> <span class="nav-text">Users</span>
                        </a>
                        <a class="nav-sublink @SubLinkClass("/settings/login-history")" href="/settings/login-history" title="Login History">
                            <i class="bi bi-clock-history"></i> <span class="nav-text">Login History</span>
                        </a>
                    </Authorized>
                </AuthorizeView>
            </div>
        </nav>
    </aside>

    @if (_sidebarOpen)
    {
        <div class="sidebar-backdrop d-lg-none" @onclick="CloseSidebar"></div>
    }

    <div class="app-main">
        <header class="app-topbar">
            <button class="sidebar-toggle d-lg-none" type="button" @onclick="ToggleSidebar" aria-label="Open menu">
                <i class="bi bi-list"></i>
            </button>
            <button class="sidebar-toggle d-none d-lg-inline-flex" type="button" @onclick="ToggleCollapse" aria-label="Toggle sidebar" title="Toggle sidebar">
                <i class="bi bi-layout-sidebar"></i>
            </button>
            <div class="topbar-title">@(_companyName ?? "Transportation Management System")</div>
            <AuthorizeView>
                <Authorized>
                    <div class="topbar-user dropdown">
                        <button class="btn btn-link text-decoration-none dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i>
                            <span class="d-none d-sm-inline">@context.User.FindFirst("FullName")?.Value</span>
                            <span class="badge bg-light text-dark border ms-2">@context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <form method="post" action="/auth/logout">
                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-box-arrow-right me-1"></i>Sign out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </Authorized>
            </AuthorizeView>
        </header>

        <main class="app-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private string? _companyName;
    private string? _companyLogoUrl;
    private bool _sidebarOpen;
    private bool _sidebarCollapsed;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;

        try
        {
            var profile = await Api.GetCompanyProfileAsync();
            if (profile is not null)
            {
                _companyName = profile.CompanyName;
                _companyLogoUrl = profile.LogoUrl;
            }
        }
        catch
        {
            // Fall back to defaults if the profile can't be loaded.
        }
    }

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    private void ToggleCollapse() => _sidebarCollapsed = !_sidebarCollapsed;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => CloseSidebar();

    private void CloseSidebar()
    {
        if (!_sidebarOpen) return;
        _sidebarOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private string SubLinkClass(string href)
    {
        var relativePath = Nav.ToBaseRelativePath(Nav.Uri);
        if (href == "/") return relativePath.Length == 0 ? "active" : "";
        return relativePath.StartsWith(href.TrimStart('/'), StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
