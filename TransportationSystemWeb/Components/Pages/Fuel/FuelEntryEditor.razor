@page "/fuel-entries/new"
@page "/fuel-entries/{Id:int}/edit"
@attribute [Authorize]
@inject FleetApiClient Api
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Add Fuel Entry" : "Edit Fuel Entry") - Fuel Management</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">
            @if (IsNew)
            {
                <text>Add Fuel Entry</text>
            }
            else
            {
                <span class="font-monospace">@_detail?.FuelEntryCode</span>
            }
        </h2>
        <div class="text-muted small">Fuel Management &rsaquo; Fuel Log</div>
    </div>
    <a class="btn btn-outline-secondary" href="/fuel-entries"><i class="bi bi-arrow-left me-1"></i>Back to list</a>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
@if (_message is not null)
{
    <div class="alert alert-success">@_message</div>
}

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <div class="card"><div class="card-body">
            <h5 class="card-title">Fuel Entry</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Entry Code</label>
                    <input class="form-control" value="@(IsNew ? "(auto-generated on save)" : _detail?.FuelEntryCode)" disabled />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Vehicle *</label>
                    <InputSelect class="form-select" @bind-Value="_model.VehicleId">
                        <option value="0">Select a vehicle...</option>
                        @foreach (var v in _vehicles)
                        {
                            <option value="@v.Id">@v.VehicleCode &mdash; @v.RegistrationNumber</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Date *</label>
                    <InputDate class="form-control" @bind-Value="_model.Date" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Driver</label>
                    <InputSelect class="form-select" @bind-Value="_model.DriverId">
                        <option value="">— None —</option>
                        @foreach (var d in _drivers)
                        {
                            <option value="@d.Id">@d.DriverCode &mdash; @d.FullName</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-8">
                    <label class="form-label">Trip</label>
                    <InputSelect class="form-select" @bind-Value="_model.TripId">
                        <option value="">— None —</option>
                        @foreach (var t in _trips)
                        {
                            <option value="@t.Id">@t.TripCode &mdash; @t.Origin &rarr; @t.Destination</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Odometer Reading *</label>
                    <InputNumber class="form-control" @bind-Value="_model.OdometerReading" />
                    <ValidationMessage For="() => _model.OdometerReading" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Litres *</label>
                    <InputNumber class="form-control" @bind-Value="_model.Litres" />
                    <ValidationMessage For="() => _model.Litres" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Rate / Litre *</label>
                    <InputNumber class="form-control" @bind-Value="_model.RatePerLitre" />
                    <ValidationMessage For="() => _model.RatePerLitre" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Total Cost</label>
                    <input class="form-control" value="@((_model.Litres * _model.RatePerLitre).ToString("N2"))" disabled />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Fuel Type *</label>
                    <InputSelect class="form-select" @bind-Value="_model.FuelType">
                        @foreach (var t in Enum.GetValues<FuelType>())
                        {
                            <option value="@t">@t.ToDisplayName()</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Payment Mode *</label>
                    <InputSelect class="form-select" @bind-Value="_model.PaymentMode">
                        @foreach (var m in Enum.GetValues<FuelPaymentMode>())
                        {
                            <option value="@m">@m.ToDisplayName()</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Station</label>
                    <InputText class="form-control" @bind-Value="_model.StationName" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Slip Number</label>
                    <InputText class="form-control" @bind-Value="_model.SlipNumber" />
                </div>

                <div class="col-md-3 d-flex align-items-center">
                    <div class="form-check mt-4">
                        <InputCheckbox class="form-check-input" id="tankFull" @bind-Value="_model.IsTankFull" />
                        <label class="form-check-label" for="tankFull">Tank filled full</label>
                    </div>
                </div>
                <div class="col-md-9">
                    <label class="form-label">Notes</label>
                    <InputText class="form-control" @bind-Value="_model.Notes" />
                </div>

                @if (!IsNew && _detail is not null)
                {
                    <div class="col-12">
                        <div class="alert alert-light border mb-0 d-flex gap-4 flex-wrap">
                            <div><span class="text-muted small d-block">Distance since last fill</span>@(_detail.DistanceSinceLast?.ToString("N0") ?? "—") km</div>
                            <div><span class="text-muted small d-block">Mileage</span>@(_detail.Mileage?.ToString("0.00") ?? "—") km/L</div>
                            <div><span class="text-muted small d-block">Cost per km</span>@(_detail.CostPerKm?.ToString("0.00") ?? "—")</div>
                        </div>
                    </div>
                }
            </div>
        </div></div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@(IsNew ? "Create Entry" : "Save Changes")</button>
            <a class="btn btn-outline-secondary" href="/fuel-entries">Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;

    private bool _loading = true;
    private string? _error;
    private string? _message;

    private FuelEntryUpsertDto _model = new() { Date = DateOnly.FromDateTime(DateTime.Today), FuelType = FuelType.Diesel };
    private FuelEntryDetailDto? _detail;
    private List<VehicleListItemDto> _vehicles = new();
    private List<DriverListItemDto> _drivers = new();
    private List<TripListItemDto> _trips = new();

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _vehicles = await Api.GetVehiclesAsync();
            _drivers = await Api.GetDriversAsync();
            _trips = await Api.GetTripsAsync();

            if (Id.HasValue)
            {
                _detail = await Api.GetFuelEntryAsync(Id.Value);
                if (_detail is null)
                {
                    _error = "Fuel entry not found.";
                }
                else
                {
                    _model = _detail;
                }
            }
            else
            {
                _detail = null;
                _model = new FuelEntryUpsertDto { Date = DateOnly.FromDateTime(DateTime.Today), FuelType = FuelType.Diesel };
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load fuel entry: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Save()
    {
        _error = null;
        _message = null;

        if (_model.VehicleId == 0)
        {
            _error = "Select a vehicle.";
            return;
        }

        try
        {
            if (IsNew)
            {
                var created = await Api.CreateFuelEntryAsync(_model);
                Nav.NavigateTo($"/fuel-entries/{created.Id}/edit");
            }
            else
            {
                await Api.UpdateFuelEntryAsync(Id!.Value, _model);
                _message = "Changes saved.";
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to save fuel entry: {ex.Message}";
        }
    }
}
