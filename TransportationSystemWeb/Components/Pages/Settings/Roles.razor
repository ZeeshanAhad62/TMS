@page "/settings/roles"
@attribute [Authorize(Roles = "Admin")]
@inject FleetApiClient Api

<PageTitle>Roles &amp; Permissions - Settings</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Roles &amp; Permissions</h2>
        <div class="text-muted small">Settings &rsaquo; Roles &amp; Permissions</div>
    </div>
    <a class="btn btn-outline-primary" href="/settings/users"><i class="bi bi-people me-1"></i>Manage Users</a>
</div>

<div class="card mb-3"><div class="card-body">
    <h5 class="card-title">What each role can do</h5>
    <p class="text-muted small">Enforced by the API on every request. A user's role is set on the <a href="/settings/users">Users</a> screen.</p>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead class="table-light">
                <tr><th>Capability</th><th class="text-center">Viewer</th><th class="text-center">Fleet Manager</th><th class="text-center">Admin</th></tr>
            </thead>
            <tbody>
                <tr><td>View all data (fleet, trips, billing, reports, …)</td><td class="text-center">✔</td><td class="text-center">✔</td><td class="text-center">✔</td></tr>
                <tr><td>Create / edit / delete operational records</td><td class="text-center text-muted">—</td><td class="text-center">✔</td><td class="text-center">✔</td></tr>
                <tr><td>Record goods receipts, deliveries, pay runs, claims</td><td class="text-center text-muted">—</td><td class="text-center">✔</td><td class="text-center">✔</td></tr>
                <tr><td>Manage users &amp; assign roles</td><td class="text-center text-muted">—</td><td class="text-center text-muted">—</td><td class="text-center">✔</td></tr>
                <tr><td>Edit the company profile</td><td class="text-center text-muted">—</td><td class="text-center text-muted">—</td><td class="text-center">✔</td></tr>
                <tr><td>View the audit log</td><td class="text-center text-muted">—</td><td class="text-center text-muted">—</td><td class="text-center">✔</td></tr>
            </tbody>
        </table>
    </div>
    <div class="text-muted small">A Viewer who clicks a save/delete button gets a "read-only" error from the server.</div>
</div></div>

<div class="card"><div class="card-body">
    <h5 class="card-title">Current users</h5>
    @if (_users is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="row g-2 mb-3">
            @foreach (var r in Enum.GetValues<UserRole>())
            {
                <div class="col-auto">
                    <span class="badge @RoleClass(r) me-1">@r.ToDisplayName()</span>
                    <span class="text-muted small">@_users.Count(u => u.Role == r)</span>
                </div>
            }
        </div>
        <table class="table table-sm align-middle">
            <thead class="table-light"><tr><th>Username</th><th>Full Name</th><th>Role</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var u in _users.OrderBy(u => u.Role).ThenBy(u => u.Username))
            {
                <tr>
                    <td class="font-monospace">@u.Username</td>
                    <td>@u.FullName</td>
                    <td><span class="badge @RoleClass(u.Role)">@u.Role.ToDisplayName()</span></td>
                    <td>@(u.IsActive ? "Active" : "Inactive")</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/settings/users">Edit</a></td>
                </tr>
            }
            </tbody>
        </table>
    }
</div></div>

@code {
    private List<UserDto>? _users;

    protected override async Task OnInitializedAsync()
    {
        try { _users = await Api.GetUsersAsync(); }
        catch { _users = new(); }
    }

    private static string RoleClass(UserRole r) => r switch
    {
        UserRole.Admin => "bg-danger",
        UserRole.FleetManager => "bg-primary",
        UserRole.Viewer => "bg-secondary",
        _ => "bg-secondary"
    };
}
