@page "/settings/users"
@attribute [Authorize(Roles = "Admin")]
@inject FleetApiClient Api

<PageTitle>Users - Settings</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Users</h2>
        <div class="text-muted small">Settings &rsaquo; Users</div>
    </div>
    <button class="btn btn-primary" @onclick="() => _showCreate = true">
        <i class="bi bi-person-plus me-1"></i>Add User
    </button>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_showCreate)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">New User</h5>
            <EditForm Model="_newUser" OnValidSubmit="CreateUser">
                <DataAnnotationsValidator />
                <div class="row g-2">
                    <div class="col-md-3">
                        <label class="form-label">Username *</label>
                        <InputText class="form-control" @bind-Value="_newUser.Username" />
                        <ValidationMessage For="() => _newUser.Username" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Full Name *</label>
                        <InputText class="form-control" @bind-Value="_newUser.FullName" />
                        <ValidationMessage For="() => _newUser.FullName" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Email *</label>
                        <InputText class="form-control" @bind-Value="_newUser.Email" />
                        <ValidationMessage For="() => _newUser.Email" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Role *</label>
                        <InputSelect class="form-select" @bind-Value="_newUser.Role">
                            @foreach (var r in Enum.GetValues<UserRole>())
                            {
                                <option value="@r">@r.ToDisplayName()</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Password *</label>
                        <InputText class="form-control" type="password" @bind-Value="_newUser.Password" />
                        <ValidationMessage For="() => _newUser.Password" />
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _showCreate = false">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (_users is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover bg-white align-middle">
            <thead class="table-light">
                <tr>
                    <th>Username</th><th>Full Name</th><th>Email</th><th>Role</th><th>Status</th><th>Last Login</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in _users)
                {
                    <tr>
                        <td>@u.Username</td>
                        <td>@u.FullName</td>
                        <td>@u.Email</td>
                        <td>@u.Role.ToDisplayName()</td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>@(u.LastLoginAt?.ToLocalTime().ToString("dd-MMM-yyyy HH:mm") ?? "—")</td>
                        <td class="text-end">
                            @if (u.IsActive)
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Deactivate(u.Id)">Deactivate</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-success" @onclick="() => Activate(u.Id)">Activate</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<UserDto>? _users;
    private string? _error;
    private bool _showCreate;
    private UserCreateDto _newUser = new();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _error = null;
        try
        {
            _users = await Api.GetUsersAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load users: {ex.Message}";
            _users = new();
        }
    }

    private async Task CreateUser()
    {
        _error = null;
        try
        {
            await Api.CreateUserAsync(_newUser);
            _newUser = new();
            _showCreate = false;
            await Load();
        }
        catch (Exception ex)
        {
            _error = $"Failed to create user: {ex.Message}";
        }
    }

    private async Task Deactivate(int id)
    {
        _error = null;
        try
        {
            await Api.DeactivateUserAsync(id);
            await Load();
        }
        catch (Exception ex)
        {
            _error = $"Failed to deactivate user: {ex.Message}";
        }
    }

    private async Task Activate(int id)
    {
        _error = null;
        try
        {
            await Api.ActivateUserAsync(id);
            await Load();
        }
        catch (Exception ex)
        {
            _error = $"Failed to activate user: {ex.Message}";
        }
    }
}
