@page "/"
@attribute [Authorize]
@inject FleetApiClient Api
@inject IJSRuntime JS

<PageTitle>Overview - Transportation Management System</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Overview</h2>
        <div class="text-muted small">Dashboard &rsaquo; Overview</div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary btn-sm" href="/fleet-vehicles"><i class="bi bi-truck me-1"></i>Fleet Master</a>
        <a class="btn btn-outline-primary btn-sm" href="/drivers"><i class="bi bi-person-badge me-1"></i>Driver Master</a>
        <a class="btn btn-outline-primary btn-sm" href="/customers"><i class="bi bi-people me-1"></i>Customer Master</a>
        <a class="btn btn-outline-primary btn-sm" href="/trips"><i class="bi bi-calendar-check me-1"></i>Trip List</a>
        <a class="btn btn-outline-primary btn-sm" href="/fuel-entries"><i class="bi bi-fuel-pump me-1"></i>Fuel Log</a>
        <a class="btn btn-outline-primary btn-sm" href="/invoices"><i class="bi bi-receipt me-1"></i>Invoices</a>
        <a class="btn btn-outline-primary btn-sm" href="/workorders"><i class="bi bi-tools me-1"></i>Work Orders</a>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_vehicles is null || _drivers is null || _trips is null || _workOrders is null || _customers is null || _fuelEntries is null)
{
    <p><em>Loading...</em></p>
}
@* billing aging (_aging) and compliance summary (_compliance) load separately and may be null *@
else
{
    @if (_compliance is not null && (_compliance.Expired + _compliance.Critical + _compliance.Warning) > 0)
    {
        <a href="/compliance" class="text-decoration-none">
            <div class="alert @(_compliance.Expired > 0 ? "alert-danger" : "alert-warning") d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-shield-exclamation me-2"></i>
                    <strong>@_compliance.Expired</strong> expired,
                    <strong>@_compliance.Critical</strong> critical (&le;7d),
                    <strong>@_compliance.Warning</strong> expiring within 30 days
                    <span class="text-muted">— vehicles &amp; drivers</span>
                </span>
                <span class="btn btn-sm btn-outline-dark">Open Compliance <i class="bi bi-arrow-right"></i></span>
            </div>
        </a>
    }

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="stat-label">Total Vehicles</div>
                                <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-truck"></i></div>
                            </div>
                            <div class="stat-value">@TotalVehicles</div>
                            <div class="stat-sub text-success"><i class="bi bi-check-circle me-1"></i>@AvailableCount available</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="stat-label">Documents Expiring</div>
                                <div class="stat-icon bg-warning bg-opacity-25 text-warning-emphasis"><i class="bi bi-file-earmark-exclamation"></i></div>
                            </div>
                            <div class="stat-value">@ExpiringCount</div>
                            <div class="stat-sub text-muted">Within next 30 days</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="stat-label">Under Maintenance</div>
                                <div class="stat-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-tools"></i></div>
                            </div>
                            <div class="stat-value">@MaintenanceCount</div>
                            <div class="stat-sub text-muted">@OutOfServiceCount out of service</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <div class="card chart-card h-100">
                        <div class="card-body">
                            <h6 class="mb-2">Fleet by Status</h6>
                            <div class="chart-wrap"><canvas id="statusChart"></canvas></div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card chart-card h-100">
                        <div class="card-body">
                            <h6 class="mb-2">Fleet by Type</h6>
                            <div class="chart-wrap"><canvas id="typeChart"></canvas></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="mb-3">Fleet by Location</h6>
                    @if (!TopLocations.Any())
                    {
                        <div class="text-muted small">No location data recorded yet.</div>
                    }
                    else
                    {
                        @foreach (var (location, count) in TopLocations)
                        {
                            <div class="side-list-row">
                                <div class="side-list-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-geo-alt"></i></div>
                                <div class="flex-grow-1 text-truncate">@location</div>
                                <span class="badge bg-light text-dark border">@count</span>
                            </div>
                        }
                    }
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <h6 class="mb-3">Upcoming Expiries</h6>
                    @if (!UpcomingExpiries.Any())
                    {
                        <div class="text-muted small">Nothing on the horizon.</div>
                    }
                    else
                    {
                        @foreach (var v in UpcomingExpiries)
                        {
                            <div class="side-list-row">
                                <div class="side-list-icon bg-secondary bg-opacity-10 text-secondary"><i class="bi bi-file-earmark-text"></i></div>
                                <div class="flex-grow-1 text-truncate">
                                    <div class="font-monospace small">@v.VehicleCode</div>
                                    <div class="text-muted" style="font-size:0.75rem;">@v.RegistrationNumber</div>
                                </div>
                                <span class="badge @ExpiryBadgeClass(v)">@ExpiryBadgeText(v)</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="mb-0">Document Expiry Tracker</h6>
                    <div class="text-muted small">Registration, fitness, permit, insurance, pollution &amp; road tax</div>
                </div>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn @(!_showExpiringOnly ? "btn-primary" : "btn-outline-secondary")" @onclick="() => _showExpiringOnly = false">All</button>
                    <button type="button" class="btn @(_showExpiringOnly ? "btn-primary" : "btn-outline-secondary")" @onclick="() => _showExpiringOnly = true">Expiring Only</button>
                </div>
            </div>

            @if (ExpiryTrackerRows.Count == 0)
            {
                <div class="text-muted small">No documents with an expiry date on file.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Vehicle Code</th>
                                <th>Registration No.</th>
                                <th>Type</th>
                                <th>Nearest Expiry</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in ExpiryTrackerRows)
                            {
                                <tr>
                                    <td><span class="font-monospace">@v.VehicleCode</span></td>
                                    <td>@v.RegistrationNumber</td>
                                    <td>@v.VehicleType.ToDisplayName()</td>
                                    <td>@v.NearestDocumentExpiry!.Value.ToString("dd-MMM-yyyy")</td>
                                    <td><span class="badge @ExpiryBadgeClass(v)">@ExpiryBadgeText(v)</span></td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary" href="/fleet-vehicles/@v.Id/edit">
                                            <i class="bi bi-pencil-square"></i> Open
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <hr class="my-4" />

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="stat-label">Total Drivers</div>
                                <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-person-badge"></i></div>
                            </div>
                            <div class="stat-value">@TotalDrivers</div>
                            <div class="stat-sub text-success"><i class="bi bi-check-circle me-1"></i>@ActiveDriverCount active</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="stat-label">Licenses Expiring</div>
                                <div class="stat-icon bg-warning bg-opacity-25 text-warning-emphasis"><i class="bi bi-file-earmark-exclamation"></i></div>
                            </div>
                            <div class="stat-value">@LicenseExpiringCount</div>
                            <div class="stat-sub text-muted">Within next 30 days</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="stat-label">On Leave / Suspended</div>
                                <div class="stat-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-person-dash"></i></div>
                            </div>
                            <div class="stat-value">@UnavailableDriverCount</div>
                            <div class="stat-sub text-muted">Not currently active</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="mb-3">Upcoming License Expiries</h6>
                    @if (!UpcomingLicenseExpiries.Any())
                    {
                        <div class="text-muted small">Nothing on the horizon.</div>
                    }
                    else
                    {
                        @foreach (var d in UpcomingLicenseExpiries)
                        {
                            <div class="side-list-row">
                                <div class="side-list-icon bg-secondary bg-opacity-10 text-secondary"><i class="bi bi-person-badge"></i></div>
                                <div class="flex-grow-1 text-truncate">
                                    <div class="font-monospace small">@d.DriverCode</div>
                                    <div class="text-muted" style="font-size:0.75rem;">@d.FullName</div>
                                </div>
                                <span class="badge @(d.HasExpiringDocument ? "bg-danger" : "bg-secondary")">@d.LicenseExpiryDate!.Value.ToString("dd-MMM-yyyy")</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-lg-8">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="stat-label">Total Customers</div>
                                <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-people"></i></div>
                            </div>
                            <div class="stat-value">@TotalCustomers</div>
                            <div class="stat-sub text-success"><i class="bi bi-check-circle me-1"></i>@ActiveCustomerCount active</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="stat-label">Inactive Customers</div>
                                <div class="stat-icon bg-secondary bg-opacity-10 text-secondary"><i class="bi bi-person-dash"></i></div>
                            </div>
                            <div class="stat-value">@InactiveCustomerCount</div>
                            <div class="stat-sub text-muted">Not currently trading</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="stat-label">Credit Limit Set</div>
                                <div class="stat-icon bg-warning bg-opacity-25 text-warning-emphasis"><i class="bi bi-cash-stack"></i></div>
                            </div>
                            <div class="stat-value">@CustomersWithCreditLimit</div>
                            <div class="stat-sub text-muted">@TotalCreditExtended.ToString("N0") total limit</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="mb-3">Recently Added Customers</h6>
                    @if (!RecentCustomers.Any())
                    {
                        <div class="text-muted small">No customers yet.</div>
                    }
                    else
                    {
                        @foreach (var c in RecentCustomers)
                        {
                            <div class="side-list-row">
                                <div class="side-list-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-person-vcard"></i></div>
                                <div class="flex-grow-1 text-truncate">
                                    <div class="font-monospace small">@c.CustomerCode</div>
                                    <div class="text-muted" style="font-size:0.75rem;">@c.Name</div>
                                </div>
                                <span class="badge @(c.Status == CustomerStatus.Active ? "bg-success" : "bg-secondary")">@c.Status.ToDisplayName()</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-lg-8">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="stat-label">Fuel Spend (This Month)</div>
                                <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-fuel-pump"></i></div>
                            </div>
                            <div class="stat-value">@FuelSpendThisMonth.ToString("N0")</div>
                            <div class="stat-sub text-muted">@FuelLitresThisMonth.ToString("N0") L filled</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="stat-label">Fleet Avg Mileage</div>
                                <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-speedometer2"></i></div>
                            </div>
                            <div class="stat-value">@(FleetAvgMileage?.ToString("0.00") ?? "—")</div>
                            <div class="stat-sub text-muted">km / litre (full-tank runs)</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="stat-label">Fuel Entries</div>
                                <div class="stat-icon bg-secondary bg-opacity-10 text-secondary"><i class="bi bi-list-check"></i></div>
                            </div>
                            <div class="stat-value">@TotalFuelEntries</div>
                            <div class="stat-sub text-muted">@LowMileageCount flagged low mileage</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="mb-3">Recent Fuel Fills</h6>
                    @if (!RecentFuelEntries.Any())
                    {
                        <div class="text-muted small">No fuel entries yet.</div>
                    }
                    else
                    {
                        @foreach (var f in RecentFuelEntries)
                        {
                            <div class="side-list-row">
                                <div class="side-list-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-fuel-pump"></i></div>
                                <div class="flex-grow-1 text-truncate">
                                    <div class="font-monospace small">@f.FuelEntryCode</div>
                                    <div class="text-muted" style="font-size:0.75rem;">@f.VehicleCode &mdash; @f.Litres.ToString("0.0") L</div>
                                </div>
                                <span class="badge bg-secondary">@f.Date.ToString("dd-MMM")</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    @if (_aging is not null)
    {
        <div class="row g-3 mt-1">
            <div class="col-lg-8">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="card stat-card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="stat-label">Outstanding (A/R)</div>
                                    <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-receipt"></i></div>
                                </div>
                                <div class="stat-value">@_aging.TotalOutstanding.ToString("N0")</div>
                                <div class="stat-sub text-muted">Across all open invoices</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card stat-card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="stat-label">Overdue</div>
                                    <div class="stat-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-exclamation-octagon"></i></div>
                                </div>
                                <div class="stat-value text-danger">@_aging.OverdueAmount.ToString("N0")</div>
                                <div class="stat-sub text-muted">Past due date, unpaid</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card stat-card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="stat-label">Collected This Month</div>
                                    <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-cash-coin"></i></div>
                                </div>
                                <div class="stat-value">@_aging.CollectedThisMonth.ToString("N0")</div>
                                <div class="stat-sub text-muted">Payments received</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="mb-3">Receivables Aging</h6>
                        @foreach (var b in _aging.Buckets)
                        {
                            <div class="side-list-row">
                                <div class="side-list-icon bg-secondary bg-opacity-10 text-secondary"><i class="bi bi-hourglass-split"></i></div>
                                <div class="flex-grow-1 text-truncate">@b.Label</div>
                                <span class="badge bg-light text-dark border">@b.Amount.ToString("N0")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-3 mt-1">
        <div class="col-lg-8">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="stat-label">Total Trips</div>
                                <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-calendar-check"></i></div>
                            </div>
                            <div class="stat-value">@TotalTrips</div>
                            <div class="stat-sub text-muted">All time</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="stat-label">Active Trips</div>
                                <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-play-circle"></i></div>
                            </div>
                            <div class="stat-value">@ActiveTripCount</div>
                            <div class="stat-sub text-muted">On the road now</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="stat-label">Scheduled Trips</div>
                                <div class="stat-icon bg-warning bg-opacity-25 text-warning-emphasis"><i class="bi bi-clock-history"></i></div>
                            </div>
                            <div class="stat-value">@ScheduledTripCount</div>
                            <div class="stat-sub text-muted">Upcoming</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="mb-3">Upcoming Trips</h6>
                    @if (!UpcomingTrips.Any())
                    {
                        <div class="text-muted small">Nothing scheduled.</div>
                    }
                    else
                    {
                        @foreach (var t in UpcomingTrips)
                        {
                            <div class="side-list-row">
                                <div class="side-list-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-signpost-2"></i></div>
                                <div class="flex-grow-1 text-truncate">
                                    <div class="font-monospace small">@t.TripCode</div>
                                    <div class="text-muted" style="font-size:0.75rem;">@t.Origin &rarr; @t.Destination</div>
                                </div>
                                <span class="badge bg-secondary">@t.StartDate.ToString("dd-MMM-yyyy")</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-lg-8">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="stat-label">Open Work Orders</div>
                                <div class="stat-icon bg-warning bg-opacity-25 text-warning-emphasis"><i class="bi bi-tools"></i></div>
                            </div>
                            <div class="stat-value">@OpenWorkOrderCount</div>
                            <div class="stat-sub text-muted">Awaiting workshop</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="stat-label">In Progress</div>
                                <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-wrench-adjustable"></i></div>
                            </div>
                            <div class="stat-value">@InProgressWorkOrderCount</div>
                            <div class="stat-sub text-muted">Currently in the workshop</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card stat-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="stat-label">Completed This Month</div>
                                <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-check2-circle"></i></div>
                            </div>
                            <div class="stat-value">@CompletedThisMonthCount</div>
                            <div class="stat-sub text-muted">@MonthMaintenanceCost.ToString("N0") spent this month</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="mb-3">Upcoming Scheduled Work</h6>
                    @if (!UpcomingWorkOrders.Any())
                    {
                        <div class="text-muted small">Nothing scheduled.</div>
                    }
                    else
                    {
                        @foreach (var w in UpcomingWorkOrders)
                        {
                            <div class="side-list-row">
                                <div class="side-list-icon bg-warning bg-opacity-25 text-warning-emphasis"><i class="bi bi-tools"></i></div>
                                <div class="flex-grow-1 text-truncate">
                                    <div class="font-monospace small">@w.WorkOrderCode</div>
                                    <div class="text-muted" style="font-size:0.75rem;">@w.VehicleCode &mdash; @w.Type.ToDisplayName()</div>
                                </div>
                                <span class="badge bg-secondary">@w.ScheduledDate!.Value.ToString("dd-MMM-yyyy")</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<VehicleListItemDto>? _vehicles;
    private List<DriverListItemDto>? _drivers;
    private List<TripListItemDto>? _trips;
    private List<WorkOrderListItemDto>? _workOrders;
    private List<CustomerListItemDto>? _customers;
    private List<FuelEntryListItemDto>? _fuelEntries;
    private InvoiceAgingDto? _aging;
    private ComplianceSummaryDto? _compliance;
    private string? _error;
    private bool _showExpiringOnly;
    private bool _chartsRendered;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _vehicles = await Api.GetVehiclesAsync();
            _drivers = await Api.GetDriversAsync();
            _trips = await Api.GetTripsAsync();
            _workOrders = await Api.GetWorkOrdersAsync();
            _customers = await Api.GetCustomersAsync();
            _fuelEntries = await Api.GetFuelEntriesAsync();
            _aging = await Api.GetInvoiceAgingAsync();
            _compliance = await Api.GetComplianceSummaryAsync(30);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load dashboard: {ex.Message}";
            _vehicles ??= new();
            _drivers ??= new();
            _trips ??= new();
            _workOrders ??= new();
            _customers ??= new();
            _fuelEntries ??= new();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_vehicles is { Count: > 0 } && !_chartsRendered)
        {
            _chartsRendered = true;
            await RenderChartsAsync();
        }
    }

    private async Task RenderChartsAsync()
    {
        var statusData = StatusCounts.ToList();
        await JS.InvokeVoidAsync("renderBarChart", "statusChart",
            statusData.Select(x => x.Status.ToDisplayName()).ToArray(),
            statusData.Select(x => x.Count).ToArray(),
            "#3a6df0");

        var typeData = TypeCounts.ToList();
        await JS.InvokeVoidAsync("renderBarChart", "typeChart",
            typeData.Select(x => x.Type.ToDisplayName()).ToArray(),
            typeData.Select(x => x.Count).ToArray(),
            "#22c3a6");
    }

    private int TotalVehicles => _vehicles?.Count ?? 0;
    private int AvailableCount => _vehicles?.Count(v => v.CurrentStatus == OperationalStatus.Available) ?? 0;
    private int MaintenanceCount => _vehicles?.Count(v => v.CurrentStatus == OperationalStatus.UnderMaintenance) ?? 0;
    private int OutOfServiceCount => _vehicles?.Count(v => v.CurrentStatus == OperationalStatus.OutOfService) ?? 0;
    private int ExpiringCount => _vehicles?.Count(v => v.HasExpiringDocument) ?? 0;

    private int TotalDrivers => _drivers?.Count ?? 0;
    private int ActiveDriverCount => _drivers?.Count(d => d.Status == DriverStatus.Active) ?? 0;
    private int UnavailableDriverCount => _drivers?.Count(d => d.Status is DriverStatus.OnLeave or DriverStatus.Suspended) ?? 0;
    private int LicenseExpiringCount => _drivers?.Count(d => d.HasExpiringDocument) ?? 0;

    private List<DriverListItemDto> UpcomingLicenseExpiries =>
        (_drivers ?? new())
            .Where(d => d.LicenseExpiryDate.HasValue)
            .OrderBy(d => d.LicenseExpiryDate)
            .Take(5)
            .ToList();

    private int TotalCustomers => _customers?.Count ?? 0;
    private int ActiveCustomerCount => _customers?.Count(c => c.Status == CustomerStatus.Active) ?? 0;
    private int InactiveCustomerCount => _customers?.Count(c => c.Status == CustomerStatus.Inactive) ?? 0;
    private int CustomersWithCreditLimit => _customers?.Count(c => c.CreditLimit.HasValue && c.CreditLimit.Value > 0) ?? 0;
    private decimal TotalCreditExtended => (_customers ?? new()).Where(c => c.CreditLimit.HasValue).Sum(c => c.CreditLimit!.Value);

    private List<CustomerListItemDto> RecentCustomers =>
        (_customers ?? new())
            .OrderByDescending(c => c.Id)
            .Take(5)
            .ToList();

    private int TotalFuelEntries => _fuelEntries?.Count ?? 0;

    private decimal FuelSpendThisMonth =>
        (_fuelEntries ?? new()).Where(f => IsThisMonth(f.Date)).Sum(f => f.TotalCost);

    private decimal FuelLitresThisMonth =>
        (_fuelEntries ?? new()).Where(f => IsThisMonth(f.Date)).Sum(f => f.Litres);

    private decimal? FleetAvgMileage
    {
        get
        {
            var vals = (_fuelEntries ?? new()).Where(f => f.Mileage.HasValue).Select(f => f.Mileage!.Value).ToList();
            return vals.Count == 0 ? null : Math.Round(vals.Average(), 2);
        }
    }

    private int LowMileageCount
    {
        get
        {
            var avg = FleetAvgMileage;
            if (avg is null or 0) return 0;
            return (_fuelEntries ?? new()).Count(f => f.Mileage.HasValue && f.Mileage.Value < avg.Value * 0.85m);
        }
    }

    private List<FuelEntryListItemDto> RecentFuelEntries =>
        (_fuelEntries ?? new())
            .OrderByDescending(f => f.Date)
            .ThenByDescending(f => f.Id)
            .Take(5)
            .ToList();

    private int TotalTrips => _trips?.Count ?? 0;
    private int ActiveTripCount => _trips?.Count(t => t.Status == TripStatus.Active) ?? 0;
    private int ScheduledTripCount => _trips?.Count(t => t.Status == TripStatus.Scheduled) ?? 0;

    private List<TripListItemDto> UpcomingTrips =>
        (_trips ?? new())
            .Where(t => t.Status == TripStatus.Scheduled)
            .OrderBy(t => t.StartDate)
            .Take(5)
            .ToList();

    private int OpenWorkOrderCount => _workOrders?.Count(w => w.Status == WorkOrderStatus.Open) ?? 0;
    private int InProgressWorkOrderCount => _workOrders?.Count(w => w.Status == WorkOrderStatus.InProgress) ?? 0;

    private int CompletedThisMonthCount =>
        (_workOrders ?? new()).Count(w => w.Status == WorkOrderStatus.Completed && IsThisMonth(w.CompletedDate));

    private decimal MonthMaintenanceCost =>
        (_workOrders ?? new())
            .Where(w => w.Status == WorkOrderStatus.Completed && IsThisMonth(w.CompletedDate))
            .Sum(w => w.TotalCost);

    private List<WorkOrderListItemDto> UpcomingWorkOrders =>
        (_workOrders ?? new())
            .Where(w => w.ScheduledDate.HasValue && w.Status is WorkOrderStatus.Open or WorkOrderStatus.InProgress)
            .OrderBy(w => w.ScheduledDate)
            .Take(5)
            .ToList();

    private static bool IsThisMonth(DateOnly? date)
    {
        if (!date.HasValue) return false;
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        return date.Value.Year == today.Year && date.Value.Month == today.Month;
    }

    private List<(OperationalStatus Status, int Count)> StatusCounts =>
        (_vehicles ?? new())
            .GroupBy(v => v.CurrentStatus)
            .Select(g => (g.Key, g.Count()))
            .OrderByDescending(x => x.Item2)
            .ToList();

    private List<(VehicleType Type, int Count)> TypeCounts =>
        (_vehicles ?? new())
            .GroupBy(v => v.VehicleType)
            .Select(g => (g.Key, g.Count()))
            .OrderByDescending(x => x.Item2)
            .ToList();

    private List<(string Location, int Count)> TopLocations =>
        (_vehicles ?? new())
            .Where(v => !string.IsNullOrWhiteSpace(v.CurrentLocation))
            .GroupBy(v => v.CurrentLocation!)
            .Select(g => (g.Key, g.Count()))
            .OrderByDescending(x => x.Item2)
            .Take(5)
            .ToList();

    private List<VehicleListItemDto> UpcomingExpiries =>
        (_vehicles ?? new())
            .Where(v => v.NearestDocumentExpiry.HasValue)
            .OrderBy(v => v.NearestDocumentExpiry)
            .Take(5)
            .ToList();

    private List<VehicleListItemDto> ExpiryTrackerRows =>
        (_showExpiringOnly
            ? (_vehicles ?? new()).Where(v => v.HasExpiringDocument)
            : (_vehicles ?? new()).Where(v => v.NearestDocumentExpiry.HasValue))
            .OrderBy(v => v.NearestDocumentExpiry)
            .ToList();

    private static int DaysRemaining(VehicleListItemDto v) =>
        v.NearestDocumentExpiry!.Value.DayNumber - DateOnly.FromDateTime(DateTime.UtcNow).DayNumber;

    private static string ExpiryBadgeClass(VehicleListItemDto v)
    {
        var days = DaysRemaining(v);
        if (days < 0) return "bg-danger";
        if (days <= 30) return "bg-warning text-dark";
        return "bg-success";
    }

    private static string ExpiryBadgeText(VehicleListItemDto v)
    {
        var days = DaysRemaining(v);
        if (days < 0) return "Expired";
        if (days <= 30) return $"{days}d left";
        return "OK";
    }
}
