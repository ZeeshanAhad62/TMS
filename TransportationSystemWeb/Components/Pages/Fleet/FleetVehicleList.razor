@page "/fleet-vehicles"
@attribute [Authorize]
@inject FleetApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Fleet Master</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Fleet Master</h2>
        <div class="text-muted small">Fleet Management &rsaquo; Fleet Setup &rsaquo; Fleet Master</div>
    </div>
    <a class="btn btn-primary" href="/fleet-vehicles/new">
        <i class="bi bi-plus-lg me-1"></i>Add Vehicle
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-4">
                <input class="form-control" placeholder="Search registration, code, make, model..."
                       @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="_typeFilter">
                    <option value="">All vehicle types</option>
                    @foreach (var t in Enum.GetValues<VehicleType>())
                    {
                        <option value="@t">@t.ToDisplayName()</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="_statusFilter">
                    <option value="">All statuses</option>
                    @foreach (var s in Enum.GetValues<OperationalStatus>())
                    {
                        <option value="@s">@s.ToDisplayName()</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button class="btn btn-outline-secondary" @onclick="Load">
                    <i class="bi bi-funnel me-1"></i>Apply
                </button>
            </div>
        </div>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_vehicles is null)
{
    <p><em>Loading...</em></p>
}
else if (_vehicles.Count == 0)
{
    <div class="alert alert-info">No vehicles found. Click "Add Vehicle" to create the first Fleet Master record.</div>
}
else
{
    <div class="row g-3">
        @foreach (var v in _vehicles)
        {
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <div class="card vehicle-card h-100">
                    <div class="vehicle-card-header">
                        <i class="bi @VehicleIcon(v.VehicleType) vehicle-card-icon"></i>
                        <span class="badge @StatusBadgeClass(v.CurrentStatus) vehicle-card-status">@v.CurrentStatus.ToDisplayName()</span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-0 font-monospace">@v.VehicleCode</h5>
                        <div class="text-muted small mb-2">@v.RegistrationNumber</div>

                        <div class="vehicle-card-row">
                            <i class="bi bi-truck-front text-muted"></i>
                            <span>@v.VehicleType.ToDisplayName() &middot; @($"{v.Make} {v.Model}".Trim())</span>
                        </div>
                        <div class="vehicle-card-row">
                            <i class="bi bi-geo-alt text-muted"></i>
                            <span>@(string.IsNullOrWhiteSpace(v.CurrentLocation) ? "—" : v.CurrentLocation)</span>
                        </div>
                        <div class="vehicle-card-row mb-3">
                            <i class="bi bi-file-earmark-text text-muted"></i>
                            @if (v.NearestDocumentExpiry is not null)
                            {
                                <span class="badge @(v.HasExpiringDocument ? "bg-danger" : "bg-secondary")">
                                    Expires @v.NearestDocumentExpiry.Value.ToString("dd-MMM-yyyy")
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">No document on file</span>
                            }
                        </div>

                        <div class="mt-auto d-flex gap-2">
                            <a class="btn btn-sm btn-outline-primary flex-fill" href="/fleet-vehicles/@v.Id/edit">
                                <i class="bi bi-pencil-square"></i> Open
                            </a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(v.Id)" title="Delete vehicle">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<VehicleListItemDto>? _vehicles;
    private string _search = "";
    private string _typeFilter = "";
    private string _statusFilter = "";
    private string? _error;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Load();
    }

    private async Task Load()
    {
        _error = null;
        try
        {
            VehicleType? type = string.IsNullOrEmpty(_typeFilter) ? null : Enum.Parse<VehicleType>(_typeFilter);
            OperationalStatus? status = string.IsNullOrEmpty(_statusFilter) ? null : Enum.Parse<OperationalStatus>(_statusFilter);
            _vehicles = await Api.GetVehiclesAsync(_search, type, status);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load vehicles: {ex.Message}";
            _vehicles = new();
        }
    }

    private async Task Delete(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this vehicle and all its Fleet Master records?");
        if (!confirmed) return;

        try
        {
            await Api.DeleteVehicleAsync(id);
            await Load();
        }
        catch (Exception ex)
        {
            _error = $"Failed to delete vehicle: {ex.Message}";
        }
    }

    private static string StatusBadgeClass(OperationalStatus status) => status switch
    {
        OperationalStatus.Available => "bg-success",
        OperationalStatus.OnTrip => "bg-primary",
        OperationalStatus.UnderMaintenance => "bg-warning text-dark",
        OperationalStatus.OutOfService => "bg-danger",
        _ => "bg-secondary"
    };

    private static string VehicleIcon(VehicleType type) => type switch
    {
        VehicleType.Truck => "bi-truck",
        VehicleType.Trailer => "bi-truck-flatbed",
        VehicleType.ContainerCarrier => "bi-box-seam",
        VehicleType.Van => "bi-truck-front",
        VehicleType.Bus => "bi-bus-front",
        _ => "bi-truck-front"
    };
}
