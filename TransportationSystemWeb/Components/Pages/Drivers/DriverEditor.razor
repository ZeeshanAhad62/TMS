@page "/drivers/new"
@page "/drivers/{Id:int}/edit"
@attribute [Authorize]
@inject FleetApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(IsNew ? "Add Driver" : "Edit Driver") - Driver Master</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">
            @if (IsNew)
            {
                <text>Add Driver</text>
            }
            else
            {
                <span class="font-monospace">@_detail?.DriverCode</span> <text> &mdash; </text> @_model.FullName
            }
        </h2>
        <div class="text-muted small">Driver Management &rsaquo; Driver Master</div>
    </div>
    <a class="btn btn-outline-secondary" href="/drivers"><i class="bi bi-arrow-left me-1"></i>Back to list</a>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
@if (_message is not null)
{
    <div class="alert alert-success">@_message</div>
}

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <ul class="nav nav-tabs mb-3">
            @foreach (var tab in Tabs)
            {
                <li class="nav-item">
                    <button type="button" class="nav-link @(_activeTab == tab ? "active" : "")" @onclick="() => _activeTab = tab" disabled="@(IsNew && tab != "Driver Details")">
                        @tab
                    </button>
                </li>
            }
        </ul>

        @if (_activeTab == "Driver Details")
        {
            <div class="card"><div class="card-body">
                <h5 class="card-title">Driver Details</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Driver ID / Code</label>
                        <input class="form-control" value="@(IsNew ? "(auto-generated on save)" : _detail?.DriverCode)" disabled />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Full Name *</label>
                        <InputText class="form-control" @bind-Value="_model.FullName" />
                        <ValidationMessage For="() => _model.FullName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Status *</label>
                        <InputSelect class="form-select" @bind-Value="_model.Status">
                            @foreach (var s in Enum.GetValues<DriverStatus>())
                            {
                                <option value="@s">@s.ToDisplayName()</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Phone Number *</label>
                        <InputText class="form-control" @bind-Value="_model.PhoneNumber" />
                        <ValidationMessage For="() => _model.PhoneNumber" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="_model.Email" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Date of Birth</label>
                        <InputDate class="form-control" @bind-Value="_model.DateOfBirth" />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Address</label>
                        <InputText class="form-control" @bind-Value="_model.Address" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">License Number *</label>
                        <InputText class="form-control" @bind-Value="_model.LicenseNumber" />
                        <ValidationMessage For="() => _model.LicenseNumber" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">License Type</label>
                        <InputText class="form-control" @bind-Value="_model.LicenseType" placeholder="LMV, HMV, Heavy Truck..." />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">License Expiry Date</label>
                        <InputDate class="form-control" @bind-Value="_model.LicenseExpiryDate" />
                    </div>
                </div>
            </div></div>
        }
        else if (_activeTab == "License & Documents" && _detail is not null)
        {
            <div class="card"><div class="card-body">
                <h5 class="card-title">License &amp; Documents</h5>

                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Category</label>
                        <select class="form-select" @bind="_uploadCategory">
                            @foreach (var c in Enum.GetValues<DriverDocumentCategory>())
                            {
                                <option value="@c">@c.ToDisplayName()</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">File (PDF/JPG/PNG, max 10 MB)</label>
                        <InputFile OnChange="UploadDocument" class="form-control" />
                    </div>
                </div>
                <table class="table table-sm">
                    <thead><tr><th>Category</th><th>File</th><th>Uploaded</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var d in _detail.Documents)
                    {
                        <tr>
                            <td>@d.Category.ToDisplayName()</td>
                            <td><a href="@d.DownloadUrl" target="_blank">@d.FileName</a></td>
                            <td>@d.UploadedAt.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</td>
                            <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteDocument(d.Id)"><i class="bi bi-trash"></i></button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div></div>
        }
        else if (_activeTab == "Payroll")
        {
            <div class="card mb-3"><div class="card-body">
                <h5 class="card-title">Pay Configuration</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Pay Type</label>
                        <InputSelect class="form-select" @bind-Value="_model.PayType">
                            @foreach (var t in Enum.GetValues<DriverPayType>())
                            {
                                <option value="@t">@t.ToDisplayName()</option>
                            }
                        </InputSelect>
                        <div class="form-text">
                            @(_model.PayType switch
                            {
                                DriverPayType.PerTrip => "Rate = amount paid per completed trip.",
                                DriverPayType.PerKm => "Rate = amount per km (enter distance on each pay-run line).",
                                DriverPayType.Monthly => "Rate = flat amount for the pay period.",
                                DriverPayType.Percentage => "Rate = percent of each trip's revenue.",
                                _ => ""
                            })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Pay Rate</label>
                        <InputNumber class="form-control" @bind-Value="_model.PayRate" />
                        <ValidationMessage For="() => _model.PayRate" />
                    </div>
                </div>
                <div class="text-muted small mt-2">Changes here are saved with the <strong>Save Changes</strong> button below.</div>
            </div></div>

            @if (_detail is not null)
            {
                <div class="card"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="card-title mb-0">Advances (Khata)</h5>
                        <div class="text-muted small">Outstanding: <strong class="@(_detail.AdvancesOutstanding > 0 ? "text-danger" : "")">@_detail.AdvancesOutstanding.ToString("N2")</strong></div>
                    </div>

                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-md-2"><label class="form-label">Date</label><input type="date" class="form-control" @bind="_newAdvance.Date" /></div>
                        <div class="col-md-2"><label class="form-label">Amount</label><input type="number" step="0.01" class="form-control" @bind="_newAdvance.Amount" /></div>
                        <div class="col-md-4"><label class="form-label">Reason</label><input class="form-control" @bind="_newAdvance.Reason" /></div>
                        <div class="col-md-3"><label class="form-label">Notes</label><input class="form-control" @bind="_newAdvance.Notes" /></div>
                        <div class="col-md-1 d-grid"><button type="button" class="btn btn-primary" @onclick="AddAdvance"><i class="bi bi-plus-lg"></i></button></div>
                    </div>

                    <table class="table table-sm align-middle">
                        <thead><tr><th>Date</th><th class="text-end">Amount</th><th class="text-end">Recovered</th><th class="text-end">Outstanding</th><th>Reason</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var a in _detail.Advances)
                        {
                            <tr>
                                <td>@a.Date.ToString("dd-MMM-yyyy")</td>
                                <td class="text-end">@a.Amount.ToString("N2")</td>
                                <td class="text-end" style="max-width:120px">
                                    <input type="number" step="0.01" class="form-control form-control-sm text-end"
                                           @bind="_recoveredEdits[a.Id]" @bind:after="() => SaveRecovered(a.Id)" />
                                </td>
                                <td class="text-end @(a.Outstanding > 0 ? "text-danger" : "text-success")">@a.Outstanding.ToString("N2")</td>
                                <td>@(string.IsNullOrWhiteSpace(a.Reason) ? "—" : a.Reason)</td>
                                <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAdvance(a.Id)"><i class="bi bi-trash"></i></button></td>
                            </tr>
                        }
                        @if (_detail.Advances.Count == 0)
                        {
                            <tr><td colspan="6" class="text-muted small">No advances recorded.</td></tr>
                        }
                        </tbody>
                    </table>
                    <div class="text-muted small">Recovered amounts are entered here; pay runs record their own advance-recovery figure separately.</div>
                </div></div>
            }
        }
        else if (_activeTab == "Vehicle Assignments" && _detail is not null)
        {
            <div class="card"><div class="card-body">
                <h5 class="card-title">Vehicle Assignments</h5>

                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Vehicle</label>
                        <select class="form-select" @bind="_newAssignment.VehicleId">
                            <option value="0">Select a vehicle...</option>
                            @foreach (var v in _vehicles)
                            {
                                <option value="@v.Id">@v.VehicleCode &mdash; @v.RegistrationNumber</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2"><label class="form-label">Start Date</label><input type="date" class="form-control" @bind="_newAssignment.StartDate" /></div>
                    <div class="col-md-2"><label class="form-label">End Date</label><input type="date" class="form-control" @bind="_newAssignment.EndDate" /></div>
                    <div class="col-md-2">
                        <label class="form-label">Status</label>
                        <select class="form-select" @bind="_newAssignment.Status">
                            @foreach (var s in Enum.GetValues<AssignmentStatus>())
                            {
                                <option value="@s">@s.ToDisplayName()</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2"><label class="form-label">Notes</label><input class="form-control" @bind="_newAssignment.Notes" /></div>
                    <div class="col-md-1 d-grid"><button type="button" class="btn btn-primary" @onclick="AddAssignment"><i class="bi bi-plus-lg"></i></button></div>
                </div>

                <table class="table table-sm">
                    <thead><tr><th>Vehicle</th><th>Start</th><th>End</th><th>Status</th><th>Notes</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var a in _detail.Assignments)
                    {
                        <tr>
                            <td>@a.VehicleCode &mdash; @a.VehicleRegistrationNumber</td>
                            <td>@a.StartDate.ToString("dd-MMM-yyyy")</td>
                            <td>@(a.EndDate?.ToString("dd-MMM-yyyy") ?? "—")</td>
                            <td><span class="badge @AssignmentStatusClass(a.Status)">@a.Status.ToDisplayName()</span></td>
                            <td>@a.Notes</td>
                            <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAssignment(a.Id)"><i class="bi bi-trash"></i></button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div></div>
        }

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@(IsNew ? "Create Driver" : "Save Changes")</button>
            <a class="btn btn-outline-secondary" href="/drivers">Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;

    private static readonly string[] Tabs = { "Driver Details", "License & Documents", "Vehicle Assignments", "Payroll" };

    private string _activeTab = "Driver Details";
    private bool _loading = true;
    private string? _error;
    private string? _message;

    private DriverUpsertDto _model = new();
    private DriverDetailDto? _detail;
    private List<VehicleListItemDto> _vehicles = new();

    private DriverDocumentCategory _uploadCategory = DriverDocumentCategory.DrivingLicense;

    private DriverVehicleAssignmentUpsertDto _newAssignment = new() { StartDate = DateOnly.FromDateTime(DateTime.Today) };

    private DriverAdvanceUpsertDto _newAdvance = new() { Date = DateOnly.FromDateTime(DateTime.Today) };
    private Dictionary<int, decimal> _recoveredEdits = new();

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _vehicles = await Api.GetVehiclesAsync();

            if (Id.HasValue)
            {
                _detail = await Api.GetDriverAsync(Id.Value);
                if (_detail is null)
                {
                    _error = "Driver not found.";
                }
                else
                {
                    _model = _detail;
                    _recoveredEdits = _detail.Advances.ToDictionary(a => a.Id, a => a.RecoveredAmount);
                }
            }
            else
            {
                _detail = null;
                _model = new DriverUpsertDto();
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load driver: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Save()
    {
        _error = null;
        _message = null;
        try
        {
            if (IsNew)
            {
                var created = await Api.CreateDriverAsync(_model);
                Nav.NavigateTo($"/drivers/{created.Id}/edit");
            }
            else
            {
                await Api.UpdateDriverAsync(Id!.Value, _model);
                _message = "Changes saved.";
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to save driver: {ex.Message}";
        }
    }

    // ----- Documents -----

    private async Task UploadDocument(InputFileChangeEventArgs e)
    {
        if (_detail is null) return;
        try
        {
            await using var stream = e.File.OpenReadStream(10 * 1024 * 1024);
            await Api.UploadDriverDocumentAsync(_detail.Id, _uploadCategory, e.File.Name, e.File.ContentType, stream);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to upload document: {ex.Message}";
        }
    }

    private async Task DeleteDocument(int documentId)
    {
        if (_detail is null) return;
        try
        {
            await Api.DeleteDriverDocumentAsync(_detail.Id, documentId);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to delete document: {ex.Message}";
        }
    }

    // ----- Assignments -----

    private async Task AddAssignment()
    {
        if (_detail is null) return;
        if (_newAssignment.VehicleId == 0)
        {
            _error = "Select a vehicle before adding an assignment.";
            return;
        }
        try
        {
            await Api.CreateAssignmentAsync(_detail.Id, _newAssignment);
            _newAssignment = new() { StartDate = DateOnly.FromDateTime(DateTime.Today) };
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to add assignment: {ex.Message}";
        }
    }

    private async Task DeleteAssignment(int assignmentId)
    {
        if (_detail is null) return;
        try
        {
            await Api.DeleteAssignmentAsync(_detail.Id, assignmentId);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to delete assignment: {ex.Message}";
        }
    }

    // ----- Advances -----

    private async Task AddAdvance()
    {
        if (_detail is null) return;
        if (_newAdvance.Amount <= 0)
        {
            _error = "Enter an advance amount greater than zero.";
            return;
        }
        try
        {
            await Api.CreateDriverAdvanceAsync(_detail.Id, _newAdvance);
            _newAdvance = new() { Date = DateOnly.FromDateTime(DateTime.Today) };
            _activeTab = "Payroll";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to add advance: {ex.Message}";
        }
    }

    private async Task SaveRecovered(int advanceId)
    {
        if (_detail is null) return;
        var a = _detail.Advances.FirstOrDefault(x => x.Id == advanceId);
        if (a is null) return;
        try
        {
            await Api.UpdateDriverAdvanceAsync(_detail.Id, advanceId, new DriverAdvanceUpsertDto
            {
                Date = a.Date,
                Amount = a.Amount,
                RecoveredAmount = _recoveredEdits[advanceId],
                Reason = a.Reason,
                Notes = a.Notes
            });
            _activeTab = "Payroll";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to update recovered amount: {ex.Message}";
        }
    }

    private async Task DeleteAdvance(int advanceId)
    {
        if (_detail is null) return;
        try
        {
            await Api.DeleteDriverAdvanceAsync(_detail.Id, advanceId);
            _activeTab = "Payroll";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to delete advance: {ex.Message}";
        }
    }

    private static string AssignmentStatusClass(AssignmentStatus status) => status switch
    {
        AssignmentStatus.Active => "bg-primary",
        AssignmentStatus.Completed => "bg-success",
        AssignmentStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };
}
