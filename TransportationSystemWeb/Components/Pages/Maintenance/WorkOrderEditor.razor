@page "/workorders/new"
@page "/workorders/{Id:int}/edit"
@attribute [Authorize]
@inject FleetApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(IsNew ? "Add Work Order" : "Edit Work Order") - Maintenance &amp; Workshop</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">
            @if (IsNew)
            {
                <text>Add Work Order</text>
            }
            else
            {
                <span class="font-monospace">@_detail?.WorkOrderCode</span> <text> &mdash; @_model.Type.ToDisplayName()</text>
            }
        </h2>
        <div class="text-muted small">Maintenance &amp; Workshop &rsaquo; Work Orders</div>
    </div>
    <a class="btn btn-outline-secondary" href="/workorders"><i class="bi bi-arrow-left me-1"></i>Back to list</a>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
@if (_message is not null)
{
    <div class="alert alert-success">@_message</div>
}

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <ul class="nav nav-tabs mb-3">
            @foreach (var tab in Tabs)
            {
                <li class="nav-item">
                    <button type="button" class="nav-link @(_activeTab == tab ? "active" : "")" @onclick="() => _activeTab = tab" disabled="@(IsNew && tab != "Work Order Details")">
                        @tab
                    </button>
                </li>
            }
        </ul>

        @if (_activeTab == "Work Order Details")
        {
            <div class="card"><div class="card-body">
                <h5 class="card-title">Work Order Details</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Work Order Code</label>
                        <input class="form-control" value="@(IsNew ? "(auto-generated on save)" : _detail?.WorkOrderCode)" disabled />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Vehicle *</label>
                        <InputSelect class="form-select" @bind-Value="_model.VehicleId">
                            <option value="0">Select a vehicle...</option>
                            @foreach (var v in _vehicles)
                            {
                                <option value="@v.Id">@v.VehicleCode &mdash; @v.RegistrationNumber</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Type *</label>
                        <InputSelect class="form-select" @bind-Value="_model.Type">
                            @foreach (var t in Enum.GetValues<MaintenanceType>())
                            {
                                <option value="@t">@t.ToDisplayName()</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Priority *</label>
                        <InputSelect class="form-select" @bind-Value="_model.Priority">
                            @foreach (var p in Enum.GetValues<WorkOrderPriority>())
                            {
                                <option value="@p">@p.ToDisplayName()</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Status *</label>
                        <InputSelect class="form-select" @bind-Value="_model.Status">
                            @foreach (var s in Enum.GetValues<WorkOrderStatus>())
                            {
                                <option value="@s">@s.ToDisplayName()</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Workshop / Vendor</label>
                        <InputText class="form-control" @bind-Value="_model.Workshop" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Reported Date *</label>
                        <InputDate class="form-control" @bind-Value="_model.ReportedDate" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Scheduled Date</label>
                        <InputDate class="form-control" @bind-Value="_model.ScheduledDate" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Completed Date</label>
                        <InputDate class="form-control" @bind-Value="_model.CompletedDate" />
                        <div class="form-text">Set automatically when status becomes Completed.</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Odometer</label>
                        <InputNumber class="form-control" @bind-Value="_model.Odometer" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Labour Cost</label>
                        <InputNumber class="form-control" @bind-Value="_model.LabourCost" />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Description</label>
                        <InputText class="form-control" @bind-Value="_model.Description" placeholder="Reported fault / work summary" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Notes</label>
                        <InputText class="form-control" @bind-Value="_model.Notes" />
                    </div>
                </div>

                @if (_detail is not null)
                {
                    <hr />
                    <div class="row text-center">
                        <div class="col-4">
                            <div class="text-muted small">Labour</div>
                            <div class="fs-5">@((_model.LabourCost ?? 0m).ToString("N2"))</div>
                        </div>
                        <div class="col-4">
                            <div class="text-muted small">Parts</div>
                            <div class="fs-5">@_detail.PartsCost.ToString("N2")</div>
                        </div>
                        <div class="col-4">
                            <div class="text-muted small">Total</div>
                            <div class="fs-5 fw-bold">@((( _model.LabourCost ?? 0m) + _detail.PartsCost).ToString("N2"))</div>
                        </div>
                    </div>
                }
            </div></div>
        }
        else if (_activeTab == "Parts & Materials" && _detail is not null)
        {
            <div class="card"><div class="card-body">
                <h5 class="card-title">Parts &amp; Materials</h5>

                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-5">
                        <label class="form-label">Description</label>
                        <input class="form-control" @bind="_newItem.Description" placeholder="Part / material name" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Quantity</label>
                        <input type="number" step="0.01" class="form-control" @bind="_newItem.Quantity" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Unit Cost</label>
                        <input type="number" step="0.01" class="form-control" @bind="_newItem.UnitCost" />
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="button" class="btn btn-primary" @onclick="AddItem"><i class="bi bi-plus-lg"></i></button>
                    </div>
                </div>

                <table class="table table-sm align-middle">
                    <thead><tr><th>Description</th><th class="text-end">Qty</th><th class="text-end">Unit Cost</th><th class="text-end">Line Total</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var i in _detail.Items)
                    {
                        <tr>
                            <td>@i.Description</td>
                            <td class="text-end">@i.Quantity.ToString("0.##")</td>
                            <td class="text-end">@i.UnitCost.ToString("N2")</td>
                            <td class="text-end">@i.LineTotal.ToString("N2")</td>
                            <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteItem(i.Id)"><i class="bi bi-trash"></i></button></td>
                        </tr>
                    }
                    @if (_detail.Items.Count == 0)
                    {
                        <tr><td colspan="5" class="text-muted small">No parts recorded yet.</td></tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Parts Total</th>
                            <th class="text-end">@_detail.PartsCost.ToString("N2")</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div></div>
        }

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@(IsNew ? "Create Work Order" : "Save Changes")</button>
            <a class="btn btn-outline-secondary" href="/workorders">Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;

    private static readonly string[] Tabs = { "Work Order Details", "Parts & Materials" };

    private string _activeTab = "Work Order Details";
    private bool _loading = true;
    private string? _error;
    private string? _message;

    private WorkOrderUpsertDto _model = new() { ReportedDate = DateOnly.FromDateTime(DateTime.Today) };
    private WorkOrderDetailDto? _detail;
    private List<VehicleListItemDto> _vehicles = new();

    private WorkOrderItemUpsertDto _newItem = new() { Quantity = 1 };

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _vehicles = await Api.GetVehiclesAsync();

            if (Id.HasValue)
            {
                _detail = await Api.GetWorkOrderAsync(Id.Value);
                if (_detail is null)
                {
                    _error = "Work order not found.";
                }
                else
                {
                    _model = _detail;
                }
            }
            else
            {
                _detail = null;
                _model = new WorkOrderUpsertDto { ReportedDate = DateOnly.FromDateTime(DateTime.Today) };
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load work order: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Save()
    {
        _error = null;
        _message = null;

        if (_model.VehicleId == 0)
        {
            _error = "Select a vehicle.";
            return;
        }

        try
        {
            if (IsNew)
            {
                var created = await Api.CreateWorkOrderAsync(_model);
                Nav.NavigateTo($"/workorders/{created.Id}/edit");
            }
            else
            {
                await Api.UpdateWorkOrderAsync(Id!.Value, _model);
                _message = "Changes saved.";
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to save work order: {ex.Message}";
        }
    }

    // ----- Parts & Materials -----

    private async Task AddItem()
    {
        if (_detail is null) return;
        if (string.IsNullOrWhiteSpace(_newItem.Description))
        {
            _error = "Enter a description before adding a part.";
            return;
        }
        try
        {
            await Api.CreateWorkOrderItemAsync(_detail.Id, _newItem);
            _newItem = new() { Quantity = 1 };
            await LoadAsync();
            _activeTab = "Parts & Materials";
        }
        catch (Exception ex)
        {
            _error = $"Failed to add part: {ex.Message}";
        }
    }

    private async Task DeleteItem(int itemId)
    {
        if (_detail is null) return;
        try
        {
            await Api.DeleteWorkOrderItemAsync(_detail.Id, itemId);
            await LoadAsync();
            _activeTab = "Parts & Materials";
        }
        catch (Exception ex)
        {
            _error = $"Failed to delete part: {ex.Message}";
        }
    }
}
