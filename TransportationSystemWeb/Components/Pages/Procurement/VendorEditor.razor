@page "/vendors/new"
@page "/vendors/{Id:int}/edit"
@attribute [Authorize]
@inject FleetApiClient Api
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Add Vendor" : "Edit Vendor") - Procurement</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">
            @if (IsNew)
            {
                <text>Add Vendor</text>
            }
            else
            {
                <span class="font-monospace">@_detail?.VendorCode</span> <text> &mdash; @_model.Name</text>
            }
        </h2>
        <div class="text-muted small">Procurement &rsaquo; Vendor Master</div>
    </div>
    <a class="btn btn-outline-secondary" href="/vendors"><i class="bi bi-arrow-left me-1"></i>Back to list</a>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
@if (_message is not null)
{
    <div class="alert alert-success">@_message</div>
}

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <div class="card"><div class="card-body">
            <h5 class="card-title">Vendor Details</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Vendor Code</label>
                    <input class="form-control" value="@(IsNew ? "(auto-generated on save)" : _detail?.VendorCode)" disabled />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Name *</label>
                    <InputText class="form-control" @bind-Value="_model.Name" />
                    <ValidationMessage For="() => _model.Name" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Type *</label>
                    <InputSelect class="form-select" @bind-Value="_model.VendorType">
                        @foreach (var t in Enum.GetValues<VendorType>())
                        {
                            <option value="@t">@t.ToDisplayName()</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Contact Person</label>
                    <InputText class="form-control" @bind-Value="_model.ContactPerson" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Phone</label>
                    <InputText class="form-control" @bind-Value="_model.Phone" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="_model.Email" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Tax Number</label>
                    <InputText class="form-control" @bind-Value="_model.TaxNumber" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Payment Terms (days)</label>
                    <InputNumber class="form-control" @bind-Value="_model.PaymentTermsDays" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="active" @bind="_model.IsActive" />
                        <label class="form-check-label" for="active">Active</label>
                    </div>
                </div>

                <div class="col-md-12">
                    <label class="form-label">Address</label>
                    <InputTextArea class="form-control" rows="2" @bind-Value="_model.Address" />
                </div>
                <div class="col-md-12">
                    <label class="form-label">Notes</label>
                    <InputTextArea class="form-control" rows="2" @bind-Value="_model.Notes" />
                </div>
            </div>
        </div></div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@(IsNew ? "Create Vendor" : "Save Changes")</button>
            <a class="btn btn-outline-secondary" href="/vendors">Cancel</a>
        </div>
    </EditForm>

    @if (!IsNew && _detail is not null)
    {
        <div class="card mt-3"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="card-title mb-0">Purchase Orders</h5>
                <a class="btn btn-sm btn-outline-primary" href="/purchase-orders/new?vendorId=@_detail.Id"><i class="bi bi-plus-lg me-1"></i>New PO</a>
            </div>
            @if (_detail.PurchaseOrders.Count == 0)
            {
                <div class="text-muted small">No purchase orders for this vendor yet.</div>
            }
            else
            {
                <table class="table table-sm align-middle">
                    <thead><tr><th>PO #</th><th>Order Date</th><th>Status</th><th class="text-end">Total</th><th class="text-end">Received</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var po in _detail.PurchaseOrders)
                    {
                        <tr>
                            <td class="font-monospace">@po.PoNumber</td>
                            <td>@po.OrderDate.ToString("dd-MMM-yy")</td>
                            <td>@po.EffectiveStatus.ToDisplayName()</td>
                            <td class="text-end">@po.Total.ToString("N2")</td>
                            <td class="text-end">@po.ReceivedPercent.ToString("0.#")%</td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/purchase-orders/@po.Id/edit"><i class="bi bi-pencil-square"></i></a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div></div>
    }
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;
    private bool _loading = true;
    private string? _error;
    private string? _message;

    private VendorUpsertDto _model = new() { IsActive = true };
    private VendorDetailDto? _detail;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (Id.HasValue)
            {
                _detail = await Api.GetVendorAsync(Id.Value);
                if (_detail is null) _error = "Vendor not found.";
                else _model = _detail;
            }
            else
            {
                _detail = null;
                _model = new VendorUpsertDto { IsActive = true };
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load vendor: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Save()
    {
        _error = null;
        _message = null;
        try
        {
            if (IsNew)
            {
                var created = await Api.CreateVendorAsync(_model);
                Nav.NavigateTo($"/vendors/{created.Id}/edit");
            }
            else
            {
                await Api.UpdateVendorAsync(Id!.Value, _model);
                _message = "Changes saved.";
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to save vendor: {ex.Message}";
        }
    }
}
