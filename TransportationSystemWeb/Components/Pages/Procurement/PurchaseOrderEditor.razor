@page "/purchase-orders/new"
@page "/purchase-orders/{Id:int}/edit"
@attribute [Authorize]
@inject FleetApiClient Api
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "New PO" : "Edit PO") - Procurement</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">
            @if (IsNew)
            {
                <text>New Purchase Order</text>
            }
            else
            {
                <span class="font-monospace">@_detail?.PoNumber</span>
                <text> &mdash; @_detail?.VendorName</text>
                @if (_detail is not null)
                {
                    <span class="badge @StatusClass(_detail.EffectiveStatus) ms-2">@_detail.EffectiveStatus.ToDisplayName()</span>
                }
            }
        </h2>
        <div class="text-muted small">Procurement &rsaquo; Purchase Orders</div>
    </div>
    <a class="btn btn-outline-secondary" href="/purchase-orders"><i class="bi bi-arrow-left me-1"></i>Back to list</a>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
@if (_message is not null)
{
    <div class="alert alert-success">@_message</div>
}

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (!IsNew && _detail is not null)
    {
        <ul class="nav nav-tabs mb-3">
            @foreach (var tab in Tabs)
            {
                <li class="nav-item">
                    <button type="button" class="nav-link @(_activeTab == tab ? "active" : "")" @onclick="() => _activeTab = tab">@tab</button>
                </li>
            }
        </ul>
    }

    @if (_activeTab == "Details")
    {
        <EditForm Model="_model" OnValidSubmit="Save">
            <DataAnnotationsValidator />

            @if (!IsNew && _detail is not null)
            {
                <div class="row g-3 mb-3">
                    <div class="col-6 col-md-3"><div class="card stat-card h-100"><div class="card-body">
                        <div class="stat-label">Sub-total</div><div class="fw-semibold">@_detail.SubTotal.ToString("N2")</div>
                    </div></div></div>
                    <div class="col-6 col-md-3"><div class="card stat-card h-100"><div class="card-body">
                        <div class="stat-label">Tax</div><div class="fw-semibold">@_detail.TaxAmount.ToString("N2")</div>
                    </div></div></div>
                    <div class="col-6 col-md-3"><div class="card stat-card h-100"><div class="card-body">
                        <div class="stat-label">Total</div><div class="fw-semibold">@_detail.Total.ToString("N2")</div>
                    </div></div></div>
                    <div class="col-6 col-md-3"><div class="card stat-card h-100"><div class="card-body">
                        <div class="stat-label">Received</div><div class="fw-semibold">@_detail.ReceivedPercent.ToString("0.#")%</div>
                    </div></div></div>
                </div>
            }

            <div class="card"><div class="card-body">
                <h5 class="card-title">PO Details</h5>
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Vendor *</label>
                        <InputSelect class="form-select" @bind-Value="_model.VendorId">
                            <option value="0">Select a vendor...</option>
                            @foreach (var v in _vendors)
                            {
                                <option value="@v.Id">@v.VendorCode &mdash; @v.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Status</label>
                        <InputSelect class="form-select" @bind-Value="_model.Status">
                            @foreach (var s in Enum.GetValues<PurchaseOrderStatus>())
                            {
                                <option value="@s">@s.ToDisplayName()</option>
                            }
                        </InputSelect>
                        <div class="form-text">Partially/Fully received is set automatically as goods arrive.</div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Order Date *</label>
                        <InputDate class="form-control" @bind-Value="_model.OrderDate" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Expected</label>
                        <InputDate class="form-control" @bind-Value="_model.ExpectedDate" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Tax %</label>
                        <InputNumber class="form-control" @bind-Value="_model.TaxPercent" />
                    </div>
                    <div class="col-md-9">
                        <label class="form-label">Notes</label>
                        <InputText class="form-control" @bind-Value="_model.Notes" />
                    </div>
                </div>
            </div></div>

            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@(IsNew ? "Create PO" : "Save Changes")</button>
                <a class="btn btn-outline-secondary" href="/purchase-orders">Cancel</a>
            </div>
        </EditForm>
    }
    else if (_activeTab == "Lines" && _detail is not null)
    {
        <div class="card"><div class="card-body">
            <h5 class="card-title">Order Lines</h5>
            <div class="text-muted small mb-3">Link a line to a stocked part so receiving it adds to on-hand inventory.</div>

            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-4">
                    <label class="form-label">Description</label>
                    <input class="form-control" @bind="_newLine.Description" placeholder="Part / material" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Stocked Part</label>
                    <select class="form-select" @bind="_newLinePartId">
                        <option value="">— none —</option>
                        @foreach (var p in _parts)
                        {
                            <option value="@p.Id">@p.PartNumber — @p.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Quantity</label>
                    <input type="number" step="0.01" class="form-control" @bind="_newLine.Quantity" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Unit Price</label>
                    <input type="number" step="0.01" class="form-control" @bind="_newLine.UnitPrice" />
                </div>
                <div class="col-md-1 d-grid">
                    <button type="button" class="btn btn-primary" @onclick="AddLine"><i class="bi bi-plus-lg"></i></button>
                </div>
            </div>

            <table class="table table-sm align-middle">
                <thead><tr><th>Description</th><th>Part</th><th class="text-end">Qty</th><th class="text-end">Unit Price</th><th class="text-end">Line Total</th><th class="text-end">Received</th><th></th></tr></thead>
                <tbody>
                @foreach (var l in _detail.Lines)
                {
                    <tr>
                        <td>@l.Description</td>
                        <td class="font-monospace small">@(l.PartNumber ?? "—")</td>
                        <td class="text-end">@l.Quantity.ToString("0.##")</td>
                        <td class="text-end">@l.UnitPrice.ToString("N2")</td>
                        <td class="text-end">@l.LineTotal.ToString("N2")</td>
                        <td class="text-end">@l.QuantityReceived.ToString("0.##") / @l.Quantity.ToString("0.##")</td>
                        <td class="text-end">
                            @if (l.QuantityReceived == 0)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteLine(l.Id)"><i class="bi bi-trash"></i></button>
                            }
                        </td>
                    </tr>
                }
                @if (_detail.Lines.Count == 0)
                {
                    <tr><td colspan="7" class="text-muted small">No lines yet.</td></tr>
                }
                </tbody>
                <tfoot>
                    <tr><th colspan="4" class="text-end">Sub-total</th><th class="text-end">@_detail.SubTotal.ToString("N2")</th><th colspan="2"></th></tr>
                    <tr><th colspan="4" class="text-end">Tax (@_detail.TaxPercent.ToString("0.##")%)</th><th class="text-end">@_detail.TaxAmount.ToString("N2")</th><th colspan="2"></th></tr>
                    <tr><th colspan="4" class="text-end">Total</th><th class="text-end fw-bold">@_detail.Total.ToString("N2")</th><th colspan="2"></th></tr>
                </tfoot>
            </table>
        </div></div>
    }
    else if (_activeTab == "Receive" && _detail is not null)
    {
        <div class="card"><div class="card-body">
            <h5 class="card-title">Goods Receipt</h5>
            @if (_detail.Status == PurchaseOrderStatus.Draft)
            {
                <div class="alert alert-warning">Move the PO to <strong>Ordered</strong> on the Details tab before receiving.</div>
            }
            else if (_detail.Status == PurchaseOrderStatus.Cancelled)
            {
                <div class="alert alert-secondary">This PO is cancelled.</div>
            }
            else if (_detail.FullyReceived)
            {
                <div class="alert alert-success">Every line on this PO has been fully received.</div>
            }
            else
            {
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Receipt date</label>
                        <input type="date" class="form-control" @bind="_receiveDate" />
                    </div>
                    <div class="col-md-3 d-grid">
                        <button type="button" class="btn btn-primary" @onclick="Receive" disabled="@_receiving">
                            <i class="bi bi-box-arrow-in-down me-1"></i>@(_receiving ? "Receiving..." : "Receive entered quantities")
                        </button>
                    </div>
                </div>

                <table class="table table-sm align-middle">
                    <thead><tr><th>Description</th><th>Part</th><th class="text-end">Ordered</th><th class="text-end">Received</th><th class="text-end">Outstanding</th><th class="text-end" style="width:140px">Receive now</th></tr></thead>
                    <tbody>
                    @foreach (var l in _detail.Lines.Where(x => x.QuantityOutstanding > 0))
                    {
                        <tr>
                            <td>@l.Description</td>
                            <td class="font-monospace small">@(l.PartNumber ?? "—")</td>
                            <td class="text-end">@l.Quantity.ToString("0.##")</td>
                            <td class="text-end">@l.QuantityReceived.ToString("0.##")</td>
                            <td class="text-end">@l.QuantityOutstanding.ToString("0.##")</td>
                            <td class="text-end">
                                <input type="number" step="0.01" min="0" max="@l.QuantityOutstanding"
                                       class="form-control form-control-sm text-end" @bind="_recvQty[l.Id]" />
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="FillAll">Fill all outstanding</button>
            }
        </div></div>
    }
}

@code {
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery] public int? VendorId { get; set; }

    private bool IsNew => Id is null;
    private static readonly string[] Tabs = { "Details", "Lines", "Receive" };
    private string _activeTab = "Details";

    private bool _loading = true;
    private string? _error;
    private string? _message;

    private PurchaseOrderUpsertDto _model = New();
    private PurchaseOrderDetailDto? _detail;
    private List<VendorListItemDto> _vendors = new();
    private List<PartListItemDto> _parts = new();

    private PurchaseOrderLineUpsertDto _newLine = new() { Quantity = 1 };
    private string _newLinePartId = "";

    private DateOnly _receiveDate = DateOnly.FromDateTime(DateTime.Today);
    private Dictionary<int, decimal> _recvQty = new();
    private bool _receiving;

    private static PurchaseOrderUpsertDto New() => new()
    {
        OrderDate = DateOnly.FromDateTime(DateTime.Today),
        Status = PurchaseOrderStatus.Draft
    };

    protected override async Task OnParametersSetAsync()
    {
        _activeTab = "Details";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _vendors = await Api.GetVendorsAsync();
            _parts = await Api.GetPartsAsync();

            if (Id.HasValue)
            {
                _detail = await Api.GetPurchaseOrderAsync(Id.Value);
                if (_detail is null) { _error = "Purchase order not found."; }
                else
                {
                    _model = new PurchaseOrderUpsertDto
                    {
                        VendorId = _detail.VendorId,
                        OrderDate = _detail.OrderDate,
                        ExpectedDate = _detail.ExpectedDate,
                        Status = _detail.Status,
                        TaxPercent = _detail.TaxPercent,
                        Notes = _detail.Notes
                    };
                    _recvQty = _detail.Lines.ToDictionary(l => l.Id, _ => 0m);
                }
            }
            else
            {
                _detail = null;
                _model = New();
                if (VendorId.HasValue) _model.VendorId = VendorId.Value;
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load purchase order: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Save()
    {
        _error = null;
        _message = null;
        if (_model.VendorId == 0)
        {
            _error = "Select a vendor.";
            return;
        }
        try
        {
            if (IsNew)
            {
                var created = await Api.CreatePurchaseOrderAsync(_model);
                Nav.NavigateTo($"/purchase-orders/{created.Id}/edit");
            }
            else
            {
                await Api.UpdatePurchaseOrderAsync(Id!.Value, _model);
                _message = "Changes saved.";
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to save PO: {ex.Message}";
        }
    }

    private async Task AddLine()
    {
        _error = null;
        if (_detail is null) return;
        if (string.IsNullOrWhiteSpace(_newLine.Description))
        {
            _error = "Enter a line description.";
            return;
        }
        _newLine.PartId = int.TryParse(_newLinePartId, out var pid) ? pid : null;
        try
        {
            await Api.CreatePurchaseOrderLineAsync(_detail.Id, _newLine);
            _newLine = new() { Quantity = 1 };
            _newLinePartId = "";
            _activeTab = "Lines";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to add line: {ex.Message}";
        }
    }

    private async Task DeleteLine(int lineId)
    {
        _error = null;
        if (_detail is null) return;
        try
        {
            await Api.DeletePurchaseOrderLineAsync(_detail.Id, lineId);
            _activeTab = "Lines";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to delete line: {ex.Message}";
        }
    }

    private void FillAll()
    {
        if (_detail is null) return;
        foreach (var l in _detail.Lines)
            _recvQty[l.Id] = l.QuantityOutstanding;
    }

    private async Task Receive()
    {
        _error = null;
        _message = null;
        if (_detail is null) return;

        var lines = _recvQty.Where(kv => kv.Value > 0)
            .Select(kv => new ReceiveLineDto { LineId = kv.Key, Quantity = kv.Value })
            .ToList();
        if (lines.Count == 0)
        {
            _error = "Enter a quantity to receive on at least one line.";
            return;
        }

        _receiving = true;
        try
        {
            var result = await Api.ReceivePurchaseOrderAsync(_detail.Id, new ReceiveGoodsDto { Lines = lines, Date = _receiveDate });
            _message = $"Received {result.LinesReceived} line(s); {result.StockMovementsCreated} stock movement(s) created. Status: {result.NewStatus}.";
            if (result.Errors.Count > 0) _error = string.Join(" ", result.Errors);
            _activeTab = "Receive";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = $"Receipt failed: {ex.Message}";
        }
        finally
        {
            _receiving = false;
        }
    }

    private static string StatusClass(PurchaseOrderStatus s) => s switch
    {
        PurchaseOrderStatus.Draft => "bg-secondary",
        PurchaseOrderStatus.Ordered => "bg-primary",
        PurchaseOrderStatus.PartiallyReceived => "bg-warning text-dark",
        PurchaseOrderStatus.Received => "bg-success",
        PurchaseOrderStatus.Cancelled => "bg-dark",
        _ => "bg-light text-dark"
    };
}
