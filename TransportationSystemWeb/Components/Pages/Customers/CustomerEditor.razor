@page "/customers/new"
@page "/customers/{Id:int}/edit"
@attribute [Authorize]
@inject FleetApiClient Api
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Add Customer" : "Edit Customer") - Customer Master</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">
            @if (IsNew)
            {
                <text>Add Customer</text>
            }
            else
            {
                <span class="font-monospace">@_detail?.CustomerCode</span> <text> &mdash; @_model.Name</text>
            }
        </h2>
        <div class="text-muted small">Customer Management &rsaquo; Customer List</div>
    </div>
    <a class="btn btn-outline-secondary" href="/customers"><i class="bi bi-arrow-left me-1"></i>Back to list</a>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
@if (_message is not null)
{
    <div class="alert alert-success">@_message</div>
}

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <div class="card"><div class="card-body">
            <h5 class="card-title">Customer Details</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Customer Code</label>
                    <input class="form-control" value="@(IsNew ? "(auto-generated on save)" : _detail?.CustomerCode)" disabled />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Name *</label>
                    <InputText class="form-control" @bind-Value="_model.Name" />
                    <ValidationMessage For="() => _model.Name" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Status *</label>
                    <InputSelect class="form-select" @bind-Value="_model.Status">
                        @foreach (var s in Enum.GetValues<CustomerStatus>())
                        {
                            <option value="@s">@s.ToDisplayName()</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Contact Person</label>
                    <InputText class="form-control" @bind-Value="_model.ContactPerson" />
                    <ValidationMessage For="() => _model.ContactPerson" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Phone *</label>
                    <InputText class="form-control" @bind-Value="_model.Phone" />
                    <ValidationMessage For="() => _model.Phone" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="_model.Email" />
                    <ValidationMessage For="() => _model.Email" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Tax Number (GST / NTN)</label>
                    <InputText class="form-control" @bind-Value="_model.TaxNumber" />
                    <ValidationMessage For="() => _model.TaxNumber" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Credit Limit</label>
                    <InputNumber class="form-control" @bind-Value="_model.CreditLimit" />
                    <ValidationMessage For="() => _model.CreditLimit" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Payment Terms (days)</label>
                    <InputNumber class="form-control" @bind-Value="_model.PaymentTermsDays" />
                    <ValidationMessage For="() => _model.PaymentTermsDays" />
                </div>

                <div class="col-md-12">
                    <label class="form-label">Billing Address</label>
                    <InputTextArea class="form-control" rows="2" @bind-Value="_model.BillingAddress" />
                </div>

                <div class="col-md-12">
                    <label class="form-label">Notes</label>
                    <InputTextArea class="form-control" rows="2" @bind-Value="_model.Notes" />
                </div>
            </div>
        </div></div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@(IsNew ? "Create Customer" : "Save Changes")</button>
            <a class="btn btn-outline-secondary" href="/customers">Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;

    private bool _loading = true;
    private string? _error;
    private string? _message;

    private CustomerUpsertDto _model = new();
    private CustomerDetailDto? _detail;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (Id.HasValue)
            {
                _detail = await Api.GetCustomerAsync(Id.Value);
                if (_detail is null)
                {
                    _error = "Customer not found.";
                }
                else
                {
                    _model = _detail;
                }
            }
            else
            {
                _detail = null;
                _model = new CustomerUpsertDto();
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load customer: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Save()
    {
        _error = null;
        _message = null;

        try
        {
            if (IsNew)
            {
                var created = await Api.CreateCustomerAsync(_model);
                Nav.NavigateTo($"/customers/{created.Id}/edit");
            }
            else
            {
                await Api.UpdateCustomerAsync(Id!.Value, _model);
                _message = "Changes saved.";
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to save customer: {ex.Message}";
        }
    }
}
