@page "/customers"
@attribute [Authorize]
@inject FleetApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Customer Master</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Customer Master</h2>
        <div class="text-muted small">Customer Management &rsaquo; Customer List</div>
    </div>
    <a class="btn btn-primary" href="/customers/new">
        <i class="bi bi-plus-lg me-1"></i>Add Customer
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-5">
                <input class="form-control" placeholder="Search code, name, contact, phone..."
                       @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
            </div>
            <div class="col-md-4">
                <select class="form-select" @bind="_statusFilter">
                    <option value="">All statuses</option>
                    @foreach (var s in Enum.GetValues<CustomerStatus>())
                    {
                        <option value="@s">@s.ToDisplayName()</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-grid">
                <button class="btn btn-outline-secondary" @onclick="Load">
                    <i class="bi bi-funnel me-1"></i>Apply
                </button>
            </div>
        </div>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_customers is null)
{
    <p><em>Loading...</em></p>
}
else if (_customers.Count == 0)
{
    <div class="alert alert-info">No customers found. Click "Add Customer" to create the first one.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover bg-white align-middle">
            <thead class="table-light">
                <tr>
                    <th>Code</th><th>Name</th><th>Contact</th><th>Phone</th><th>Credit Limit</th><th>Terms</th><th>Status</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _customers)
                {
                    <tr>
                        <td class="font-monospace">@c.CustomerCode</td>
                        <td>@c.Name</td>
                        <td>@(string.IsNullOrWhiteSpace(c.ContactPerson) ? "—" : c.ContactPerson)</td>
                        <td>@c.Phone</td>
                        <td>@(c.CreditLimit?.ToString("N0") ?? "—")</td>
                        <td>@(c.PaymentTermsDays.HasValue ? $"{c.PaymentTermsDays}d" : "—")</td>
                        <td><span class="badge @StatusBadgeClass(c.Status)">@c.Status.ToDisplayName()</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="/customers/@c.Id/edit"><i class="bi bi-pencil-square"></i></a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(c.Id)" title="Delete customer">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<CustomerListItemDto>? _customers;
    private string _search = "";
    private string _statusFilter = "";
    private string? _error;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Load();
    }

    private async Task Load()
    {
        _error = null;
        try
        {
            CustomerStatus? status = string.IsNullOrEmpty(_statusFilter) ? null : Enum.Parse<CustomerStatus>(_statusFilter);
            _customers = await Api.GetCustomersAsync(status, _search);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load customers: {ex.Message}";
            _customers = new();
        }
    }

    private async Task Delete(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this customer?");
        if (!confirmed) return;

        try
        {
            await Api.DeleteCustomerAsync(id);
            await Load();
        }
        catch (Exception ex)
        {
            _error = $"Failed to delete customer: {ex.Message}";
        }
    }

    private static string StatusBadgeClass(CustomerStatus status) => status switch
    {
        CustomerStatus.Active => "bg-success",
        CustomerStatus.Inactive => "bg-secondary",
        _ => "bg-secondary"
    };
}
