@page "/trips/new"
@page "/trips/{Id:int}/edit"
@attribute [Authorize]
@inject FleetApiClient Api
@inject NavigationManager Nav

<PageTitle>@(IsNew ? "Add Trip" : "Edit Trip") - Trip / Booking</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">
            @if (IsNew)
            {
                <text>Add Trip</text>
            }
            else
            {
                <span class="font-monospace">@_detail?.TripCode</span> <text> &mdash; @_model.Origin &rarr; @_model.Destination</text>
            }
        </h2>
        <div class="text-muted small">Trip / Booking &rsaquo; Trip List</div>
    </div>
    <a class="btn btn-outline-secondary" href="/trips"><i class="bi bi-arrow-left me-1"></i>Back to list</a>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
@if (_message is not null)
{
    <div class="alert alert-success">@_message</div>
}

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <div class="card"><div class="card-body">
            <h5 class="card-title">Trip Details</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Trip Code</label>
                    <input class="form-control" value="@(IsNew ? "(auto-generated on save)" : _detail?.TripCode)" disabled />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Vehicle *</label>
                    <InputSelect class="form-select" @bind-Value="_model.VehicleId">
                        <option value="0">Select a vehicle...</option>
                        @foreach (var v in _vehicles)
                        {
                            <option value="@v.Id">@v.VehicleCode &mdash; @v.RegistrationNumber</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Driver *</label>
                    <InputSelect class="form-select" @bind-Value="_model.DriverId">
                        <option value="0">Select a driver...</option>
                        @foreach (var d in _drivers)
                        {
                            <option value="@d.Id">@d.DriverCode &mdash; @d.FullName</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Customer</label>
                    <InputSelect class="form-select" @bind-Value="_model.CustomerId">
                        <option value="">— None (internal / repositioning) —</option>
                        @foreach (var c in _customers)
                        {
                            <option value="@c.Id">@c.CustomerCode &mdash; @c.Name</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Origin *</label>
                    <InputText class="form-control" @bind-Value="_model.Origin" />
                    <ValidationMessage For="() => _model.Origin" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Destination *</label>
                    <InputText class="form-control" @bind-Value="_model.Destination" />
                    <ValidationMessage For="() => _model.Destination" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Status *</label>
                    <InputSelect class="form-select" @bind-Value="_model.Status">
                        @foreach (var s in Enum.GetValues<TripStatus>())
                        {
                            <option value="@s">@s.ToDisplayName()</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Start Date *</label>
                    <InputDate class="form-control" @bind-Value="_model.StartDate" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">End Date</label>
                    <InputDate class="form-control" @bind-Value="_model.EndDate" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Revenue</label>
                    <InputNumber class="form-control" @bind-Value="_model.Revenue" />
                </div>

                <div class="col-md-12">
                    <label class="form-label">Notes</label>
                    <InputText class="form-control" @bind-Value="_model.Notes" />
                </div>
            </div>
        </div></div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@(IsNew ? "Create Trip" : "Save Changes")</button>
            <a class="btn btn-outline-secondary" href="/trips">Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;

    private bool _loading = true;
    private string? _error;
    private string? _message;

    private TripUpsertDto _model = new() { StartDate = DateOnly.FromDateTime(DateTime.Today) };
    private TripDetailDto? _detail;
    private List<VehicleListItemDto> _vehicles = new();
    private List<DriverListItemDto> _drivers = new();
    private List<CustomerListItemDto> _customers = new();

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _vehicles = await Api.GetVehiclesAsync();
            _drivers = await Api.GetDriversAsync();
            _customers = await Api.GetCustomersAsync();

            if (Id.HasValue)
            {
                _detail = await Api.GetTripAsync(Id.Value);
                if (_detail is null)
                {
                    _error = "Trip not found.";
                }
                else
                {
                    _model = _detail;
                }
            }
            else
            {
                _detail = null;
                _model = new TripUpsertDto { StartDate = DateOnly.FromDateTime(DateTime.Today) };
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load trip: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Save()
    {
        _error = null;
        _message = null;

        if (_model.VehicleId == 0 || _model.DriverId == 0)
        {
            _error = "Select both a vehicle and a driver.";
            return;
        }

        try
        {
            if (IsNew)
            {
                var created = await Api.CreateTripAsync(_model);
                Nav.NavigateTo($"/trips/{created.Id}/edit");
            }
            else
            {
                await Api.UpdateTripAsync(Id!.Value, _model);
                _message = "Changes saved.";
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to save trip: {ex.Message}";
        }
    }
}
