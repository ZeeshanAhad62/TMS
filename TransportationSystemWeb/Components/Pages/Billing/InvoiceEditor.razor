@page "/invoices/new"
@page "/invoices/{Id:int}/edit"
@attribute [Authorize]
@inject FleetApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(IsNew ? "Add Invoice" : "Edit Invoice") - Billing</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">
            @if (IsNew)
            {
                <text>Add Invoice</text>
            }
            else
            {
                <span class="font-monospace">@_detail?.InvoiceNumber</span> <text> &mdash; @_detail?.CustomerName</text>
            }
        </h2>
        <div class="text-muted small">Billing &amp; Invoicing &rsaquo; Invoices</div>
    </div>
    <a class="btn btn-outline-secondary" href="/invoices"><i class="bi bi-arrow-left me-1"></i>Back to list</a>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
@if (_message is not null)
{
    <div class="alert alert-success">@_message</div>
}

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <ul class="nav nav-tabs mb-3">
            @foreach (var tab in Tabs)
            {
                <li class="nav-item">
                    <button type="button" class="nav-link @(_activeTab == tab ? "active" : "")" @onclick="() => _activeTab = tab" disabled="@(IsNew && tab != "Invoice Details")">
                        @tab
                    </button>
                </li>
            }
        </ul>

        @if (_activeTab == "Invoice Details")
        {
            <div class="card"><div class="card-body">
                <h5 class="card-title">Invoice Details</h5>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Invoice #</label>
                        <input class="form-control" value="@(IsNew ? "(auto-generated on save)" : _detail?.InvoiceNumber)" disabled />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Customer *</label>
                        <InputSelect class="form-select" @bind-Value="_model.CustomerId">
                            <option value="0">Select a customer...</option>
                            @foreach (var c in _customers)
                            {
                                <option value="@c.Id">@c.CustomerCode &mdash; @c.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Status *</label>
                        <InputSelect class="form-select" @bind-Value="_model.Status">
                            <option value="@InvoiceStatus.Draft">Draft</option>
                            <option value="@InvoiceStatus.Sent">Sent</option>
                            <option value="@InvoiceStatus.Cancelled">Cancelled</option>
                        </InputSelect>
                        @if (_detail is not null && _detail.EffectiveStatus != _model.Status)
                        {
                            <div class="form-text">Effective: <strong>@_detail.EffectiveStatus.ToDisplayName()</strong> (from payments)</div>
                        }
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Invoice Date *</label>
                        <InputDate class="form-control" @bind-Value="_model.InvoiceDate" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Due Date *</label>
                        <InputDate class="form-control" @bind-Value="_model.DueDate" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tax %</label>
                        <InputNumber class="form-control" @bind-Value="_model.TaxPercent" />
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Notes</label>
                        <InputText class="form-control" @bind-Value="_model.Notes" />
                    </div>
                </div>

                @if (_detail is not null)
                {
                    <hr />
                    <div class="row text-center">
                        <div class="col"><div class="text-muted small">Sub-total</div><div class="fs-6">@_detail.SubTotal.ToString("N2")</div></div>
                        <div class="col"><div class="text-muted small">Tax</div><div class="fs-6">@_detail.TaxAmount.ToString("N2")</div></div>
                        <div class="col"><div class="text-muted small">Total</div><div class="fs-6 fw-bold">@_detail.Total.ToString("N2")</div></div>
                        <div class="col"><div class="text-muted small">Paid</div><div class="fs-6 text-success">@_detail.AmountPaid.ToString("N2")</div></div>
                        <div class="col"><div class="text-muted small">Balance</div><div class="fs-6 fw-bold @(_detail.Balance > 0 ? "text-danger" : "text-success")">@_detail.Balance.ToString("N2")</div></div>
                    </div>
                }
            </div></div>
        }
        else if (_activeTab == "Lines" && _detail is not null)
        {
            <div class="card"><div class="card-body">
                <h5 class="card-title">Invoice Lines</h5>

                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-5">
                        <label class="form-label">Description</label>
                        <input class="form-control" @bind="_newLine.Description" placeholder="Freight charge / service" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Quantity</label>
                        <input type="number" step="0.01" class="form-control" @bind="_newLine.Quantity" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Unit Price</label>
                        <input type="number" step="0.01" class="form-control" @bind="_newLine.UnitPrice" />
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="button" class="btn btn-primary" @onclick="AddLine"><i class="bi bi-plus-lg"></i></button>
                    </div>
                </div>

                <table class="table table-sm align-middle">
                    <thead><tr><th>Description</th><th>Trip</th><th class="text-end">Qty</th><th class="text-end">Unit Price</th><th class="text-end">Line Total</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var l in _detail.Lines)
                    {
                        <tr>
                            <td>@l.Description</td>
                            <td class="font-monospace small">@(l.TripCode ?? "—")</td>
                            <td class="text-end">@l.Quantity.ToString("0.##")</td>
                            <td class="text-end">@l.UnitPrice.ToString("N2")</td>
                            <td class="text-end">@l.LineTotal.ToString("N2")</td>
                            <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteLine(l.Id)"><i class="bi bi-trash"></i></button></td>
                        </tr>
                    }
                    @if (_detail.Lines.Count == 0)
                    {
                        <tr><td colspan="6" class="text-muted small">No lines yet.</td></tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr><th colspan="4" class="text-end">Sub-total</th><th class="text-end">@_detail.SubTotal.ToString("N2")</th><th></th></tr>
                        <tr><th colspan="4" class="text-end">Tax (@_detail.TaxPercent.ToString("0.##")%)</th><th class="text-end">@_detail.TaxAmount.ToString("N2")</th><th></th></tr>
                        <tr><th colspan="4" class="text-end">Total</th><th class="text-end">@_detail.Total.ToString("N2")</th><th></th></tr>
                    </tfoot>
                </table>
            </div></div>
        }
        else if (_activeTab == "Payments" && _detail is not null)
        {
            <div class="card"><div class="card-body">
                <h5 class="card-title">Payments Received</h5>

                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-2">
                        <label class="form-label">Date</label>
                        <input type="date" class="form-control" @bind="_newPayment.Date" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Amount</label>
                        <input type="number" step="0.01" class="form-control" @bind="_newPayment.Amount" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Mode</label>
                        <select class="form-select" @bind="_newPayment.Mode">
                            @foreach (var m in Enum.GetValues<PaymentMode>())
                            {
                                <option value="@m">@m.ToDisplayName()</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Reference</label>
                        <input class="form-control" @bind="_newPayment.Reference" />
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="button" class="btn btn-primary" @onclick="AddPayment"><i class="bi bi-plus-lg"></i></button>
                    </div>
                </div>

                <table class="table table-sm align-middle">
                    <thead><tr><th>Date</th><th>Mode</th><th>Reference</th><th class="text-end">Amount</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var p in _detail.Payments)
                    {
                        <tr>
                            <td>@p.Date.ToString("dd-MMM-yyyy")</td>
                            <td>@p.Mode.ToDisplayName()</td>
                            <td>@(string.IsNullOrWhiteSpace(p.Reference) ? "—" : p.Reference)</td>
                            <td class="text-end">@p.Amount.ToString("N2")</td>
                            <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeletePayment(p.Id)"><i class="bi bi-trash"></i></button></td>
                        </tr>
                    }
                    @if (_detail.Payments.Count == 0)
                    {
                        <tr><td colspan="5" class="text-muted small">No payments recorded yet.</td></tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr><th colspan="3" class="text-end">Total Paid</th><th class="text-end">@_detail.AmountPaid.ToString("N2")</th><th></th></tr>
                        <tr><th colspan="3" class="text-end">Balance</th><th class="text-end @(_detail.Balance > 0 ? "text-danger" : "text-success")">@_detail.Balance.ToString("N2")</th><th></th></tr>
                    </tfoot>
                </table>
            </div></div>
        }

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@(IsNew ? "Create Invoice" : "Save Changes")</button>
            <a class="btn btn-outline-secondary" href="/invoices">Cancel</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;

    private static readonly string[] Tabs = { "Invoice Details", "Lines", "Payments" };
    private string _activeTab = "Invoice Details";

    private bool _loading = true;
    private string? _error;
    private string? _message;

    private InvoiceUpsertDto _model = NewModel();
    private InvoiceDetailDto? _detail;
    private List<CustomerListItemDto> _customers = new();

    private InvoiceLineUpsertDto _newLine = new() { Quantity = 1 };
    private PaymentUpsertDto _newPayment = NewPayment();

    private static InvoiceUpsertDto NewModel() => new()
    {
        InvoiceDate = DateOnly.FromDateTime(DateTime.Today),
        DueDate = DateOnly.FromDateTime(DateTime.Today.AddDays(30)),
        Status = InvoiceStatus.Draft
    };

    private static PaymentUpsertDto NewPayment() => new()
    {
        Date = DateOnly.FromDateTime(DateTime.Today),
        Mode = PaymentMode.Cash
    };

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _customers = await Api.GetCustomersAsync();

            if (Id.HasValue)
            {
                _detail = await Api.GetInvoiceAsync(Id.Value);
                if (_detail is null)
                {
                    _error = "Invoice not found.";
                }
                else
                {
                    _model = _detail;
                }
            }
            else
            {
                _detail = null;
                _model = NewModel();
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load invoice: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Save()
    {
        _error = null;
        _message = null;

        if (_model.CustomerId == 0)
        {
            _error = "Select a customer.";
            return;
        }

        try
        {
            if (IsNew)
            {
                var created = await Api.CreateInvoiceAsync(_model);
                Nav.NavigateTo($"/invoices/{created.Id}/edit");
            }
            else
            {
                await Api.UpdateInvoiceAsync(Id!.Value, _model);
                _message = "Changes saved.";
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to save invoice: {ex.Message}";
        }
    }

    // ----- Lines -----

    private async Task AddLine()
    {
        if (_detail is null) return;
        if (string.IsNullOrWhiteSpace(_newLine.Description))
        {
            _error = "Enter a description before adding a line.";
            return;
        }
        try
        {
            await Api.CreateInvoiceLineAsync(_detail.Id, _newLine);
            _newLine = new() { Quantity = 1 };
            await LoadAsync();
            _activeTab = "Lines";
        }
        catch (Exception ex)
        {
            _error = $"Failed to add line: {ex.Message}";
        }
    }

    private async Task DeleteLine(int lineId)
    {
        if (_detail is null) return;
        try
        {
            await Api.DeleteInvoiceLineAsync(_detail.Id, lineId);
            await LoadAsync();
            _activeTab = "Lines";
        }
        catch (Exception ex)
        {
            _error = $"Failed to delete line: {ex.Message}";
        }
    }

    // ----- Payments -----

    private async Task AddPayment()
    {
        if (_detail is null) return;
        if (_newPayment.Amount <= 0)
        {
            _error = "Enter a payment amount greater than zero.";
            return;
        }
        try
        {
            await Api.CreatePaymentAsync(_detail.Id, _newPayment);
            _newPayment = NewPayment();
            await LoadAsync();
            _activeTab = "Payments";
        }
        catch (Exception ex)
        {
            _error = $"Failed to add payment: {ex.Message}";
        }
    }

    private async Task DeletePayment(int paymentId)
    {
        if (_detail is null) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this payment?");
        if (!confirmed) return;
        try
        {
            await Api.DeletePaymentAsync(_detail.Id, paymentId);
            await LoadAsync();
            _activeTab = "Payments";
        }
        catch (Exception ex)
        {
            _error = $"Failed to delete payment: {ex.Message}";
        }
    }
}
