@page "/geofences/new"
@page "/geofences/{Id:int}/edit"
@attribute [Authorize]
@implements IAsyncDisposable
@inject FleetApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(IsNew ? "New Geofence" : "Edit Geofence") - GPS / Tracking</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">@(IsNew ? "New Geofence" : $"Edit — {_model.Name}")</h2>
        <div class="text-muted small">GPS / Tracking &rsaquo; Geofences</div>
    </div>
    <a class="btn btn-outline-secondary" href="/geofences"><i class="bi bi-arrow-left me-1"></i>Back to list</a>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
@if (_message is not null)
{
    <div class="alert alert-success">@_message</div>
}

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row g-3">
        <div class="col-lg-5">
            <EditForm Model="_model" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <div class="card"><div class="card-body">
                    <h5 class="card-title">Details</h5>
                    <div class="mb-3">
                        <label class="form-label">Name *</label>
                        <InputText class="form-control" @bind-Value="_model.Name" />
                        <ValidationMessage For="() => _model.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Shape</label>
                        <InputSelect class="form-select" @bind-Value="_model.Shape" @bind-Value:after="OnShapeChanged">
                            @foreach (var s in Enum.GetValues<GeofenceShape>())
                            {
                                <option value="@s">@s.ToDisplayName()</option>
                            }
                        </InputSelect>
                    </div>

                    @if (_model.Shape == GeofenceShape.Circle)
                    {
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label">Centre latitude</label>
                                <InputNumber class="form-control" @bind-Value="_model.CenterLat" @bind-Value:after="Preview" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">Centre longitude</label>
                                <InputNumber class="form-control" @bind-Value="_model.CenterLng" @bind-Value:after="Preview" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Radius (metres)</label>
                                <InputNumber class="form-control" @bind-Value="_model.RadiusMeters" @bind-Value:after="Preview" />
                            </div>
                        </div>
                        <div class="form-text mt-1">Click the map to drop the centre.</div>
                    }
                    else
                    {
                        <div class="mb-2">
                            <label class="form-label">Points (JSON)</label>
                            <textarea class="form-control font-monospace" rows="6" @bind="_polygonText" @bind:after="OnPolygonTextChanged"></textarea>
                            <div class="form-text">Array of <code>{"lat":..,"lng":..}</code>. Click the map to append a point.</div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearPolygon">Clear points</button>
                    }

                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" id="active" @bind="_model.IsActive" />
                        <label class="form-check-label" for="active">Active (evaluated on every incoming fix)</label>
                    </div>
                    <div class="mt-3">
                        <label class="form-label">Notes</label>
                        <InputTextArea class="form-control" rows="2" @bind-Value="_model.Notes" />
                    </div>
                </div></div>

                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@(IsNew ? "Create" : "Save Changes")</button>
                    <a class="btn btn-outline-secondary" href="/geofences">Cancel</a>
                </div>
            </EditForm>
        </div>

        <div class="col-lg-7">
            <div class="card"><div class="card-body p-0">
                <div id="geoEditorMap" style="height: 520px; border-radius: .5rem;"></div>
            </div></div>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;
    private bool _loading = true;
    private string? _error;
    private string? _message;
    private bool _mapReady;

    private GeofenceUpsertDto _model = new() { Shape = GeofenceShape.Circle, IsActive = true, RadiusMeters = 300 };
    private string _polygonText = "[]";
    private DotNetObjectReference<GeofenceEditor>? _selfRef;

    public static List<GeoPoint> ParsePoints(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<List<GeoPoint>>(json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
        }
        catch { return new(); }
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (Id.HasValue)
            {
                var d = await Api.GetGeofenceAsync(Id.Value);
                if (d is null) { _error = "Geofence not found."; }
                else
                {
                    _model = new GeofenceUpsertDto
                    {
                        Name = d.Name,
                        Shape = d.Shape,
                        CenterLat = d.CenterLat,
                        CenterLng = d.CenterLng,
                        RadiusMeters = d.RadiusMeters,
                        PolygonJson = d.PolygonJson,
                        IsActive = d.IsActive,
                        Notes = d.Notes
                    };
                    _polygonText = Pretty(d.PolygonJson);
                }
            }
        }
        catch (Exception ex) { _error = $"Failed to load geofence: {ex.Message}"; }
        finally { _loading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            var center = _model is { CenterLat: not null, CenterLng: not null }
                ? new[] { (double)_model.CenterLat!.Value, (double)_model.CenterLng!.Value }
                : new[] { 24.8607, 67.0011 };
            await JS.InvokeVoidAsync("trackingMap.init", "geoEditorMap", center, 10);
            await JS.InvokeVoidAsync("trackingMap.enablePicker", "geoEditorMap", _selfRef);
            _mapReady = true;
            await Preview();
        }
    }

    [JSInvokable]
    public async Task OnMapClick(double lat, double lng)
    {
        if (_model.Shape == GeofenceShape.Circle)
        {
            _model.CenterLat = (decimal)Math.Round(lat, 6);
            _model.CenterLng = (decimal)Math.Round(lng, 6);
        }
        else
        {
            var pts = ParsePoints(_polygonText);
            pts.Add(new GeoPoint { Lat = (decimal)Math.Round(lat, 6), Lng = (decimal)Math.Round(lng, 6) });
            _polygonText = Pretty(System.Text.Json.JsonSerializer.Serialize(pts));
            _model.PolygonJson = _polygonText;
        }
        StateHasChanged();
        await Preview();
    }

    private async Task OnShapeChanged() { await Preview(); }

    private async Task OnPolygonTextChanged()
    {
        _model.PolygonJson = _polygonText;
        await Preview();
    }

    private async Task ClearPolygon()
    {
        _polygonText = "[]";
        _model.PolygonJson = "[]";
        await Preview();
    }

    private async Task Preview()
    {
        if (!_mapReady) return;
        if (_model.Shape == GeofenceShape.Circle)
        {
            await JS.InvokeVoidAsync("trackingMap.showCircle", "geoEditorMap",
                _model.CenterLat, _model.CenterLng, _model.RadiusMeters ?? 300);
        }
        else
        {
            var pts = ParsePoints(_polygonText);
            await JS.InvokeVoidAsync("trackingMap.setGeofences", "geoEditorMap", new[]
            {
                new { name = _model.Name, shape = "Polygon", isActive = _model.IsActive, polygon = pts }
            });
        }
    }

    private async Task Save()
    {
        _error = null;
        _message = null;
        if (_model.Shape == GeofenceShape.Polygon) _model.PolygonJson = _polygonText;
        try
        {
            if (IsNew)
            {
                var created = await Api.CreateGeofenceAsync(_model);
                Nav.NavigateTo($"/geofences/{created.Id}/edit");
            }
            else
            {
                await Api.UpdateGeofenceAsync(Id!.Value, _model);
                _message = "Changes saved.";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private static string Pretty(string? json)
    {
        var pts = ParsePoints(json);
        if (pts.Count == 0) return "[]";
        return "[\n" + string.Join(",\n", pts.Select(p => $"  {{ \"lat\": {p.Lat}, \"lng\": {p.Lng} }}")) + "\n]";
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("trackingMap.dispose", "geoEditorMap"); } catch { }
        _selfRef?.Dispose();
    }
}
