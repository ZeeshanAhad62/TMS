@page "/parts/goods-receipt"
@attribute [Authorize]
@inject FleetApiClient Api
@inject NavigationManager Nav

<PageTitle>Goods Receipt - Spare Parts Inventory</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Goods Receipt</h2>
        <div class="text-muted small">Inventory &rsaquo; Goods Receipt</div>
    </div>
    <a class="btn btn-outline-secondary" href="/parts"><i class="bi bi-arrow-left me-1"></i>Back to list</a>
</div>

<div class="text-muted small mb-3">Record a batch of parts received in one go -- each line becomes its own Receipt stock movement.</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
@if (_message is not null)
{
    <div class="alert alert-success">@_message</div>
}

@if (_parts is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card"><div class="card-body">
        <h5 class="card-title">Receipt Lines</h5>

        <div class="row g-2 align-items-end mb-3">
            <div class="col-md-4">
                <label class="form-label">Part</label>
                <select class="form-select" @bind="_newLinePartId">
                    <option value="">Select a part...</option>
                    @foreach (var p in _parts)
                    {
                        <option value="@p.Id">@p.PartNumber &mdash; @p.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Quantity</label>
                <input type="number" step="0.01" class="form-control" @bind="_newLineQuantity" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Unit Cost</label>
                <input type="number" step="0.01" class="form-control" @bind="_newLineUnitCost" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Supplier</label>
                <input class="form-control" @bind="_supplierName" />
            </div>
            <div class="col-md-1 d-grid">
                <button type="button" class="btn btn-primary" @onclick="AddLine"><i class="bi bi-plus-lg"></i></button>
            </div>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-3">
                <label class="form-label">Receipt Date</label>
                <input type="date" class="form-control" @bind="_date" />
            </div>
            <div class="col-md-9">
                <label class="form-label">Notes (applied to every line)</label>
                <input class="form-control" @bind="_notes" />
            </div>
        </div>

        <table class="table table-sm align-middle">
            <thead><tr><th>Part</th><th class="text-end">Qty</th><th class="text-end">Unit Cost</th><th class="text-end">Line Value</th><th></th></tr></thead>
            <tbody>
            @foreach (var line in _lines)
            {
                <tr>
                    <td>@PartLabel(line.PartId)</td>
                    <td class="text-end">@line.Quantity.ToString("0.##")</td>
                    <td class="text-end">@(line.UnitCost?.ToString("N2") ?? "—")</td>
                    <td class="text-end">@((line.Quantity * (line.UnitCost ?? 0)).ToString("N2"))</td>
                    <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => _lines.Remove(line)"><i class="bi bi-trash"></i></button></td>
                </tr>
            }
            @if (_lines.Count == 0)
            {
                <tr><td colspan="5" class="text-muted small">Add at least one line before submitting.</td></tr>
            }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total Value</th>
                    <th class="text-end">@(_lines.Sum(l => l.Quantity * (l.UnitCost ?? 0)).ToString("N2"))</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>

        <button type="button" class="btn btn-success" disabled="@(_lines.Count == 0 || _submitting)" @onclick="Submit">
            <i class="bi bi-check2-circle me-1"></i>@(_submitting ? "Submitting..." : "Submit Receipt")
        </button>
    </div></div>
}

@code {
    private List<PartListItemDto>? _parts;
    private readonly List<Line> _lines = new();

    private string _newLinePartId = "";
    private decimal _newLineQuantity = 1;
    private decimal? _newLineUnitCost;
    private string? _supplierName;
    private DateOnly _date = DateOnly.FromDateTime(DateTime.Today);
    private string? _notes;

    private string? _error;
    private string? _message;
    private bool _submitting;

    private record Line(int PartId, decimal Quantity, decimal? UnitCost);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _parts = await Api.GetPartsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load parts: {ex.Message}";
            _parts = new();
        }
    }

    private void AddLine()
    {
        _error = null;
        if (string.IsNullOrEmpty(_newLinePartId))
        {
            _error = "Select a part.";
            return;
        }
        if (_newLineQuantity <= 0)
        {
            _error = "Quantity must be greater than zero.";
            return;
        }

        _lines.Add(new Line(int.Parse(_newLinePartId), _newLineQuantity, _newLineUnitCost));
        _newLinePartId = "";
        _newLineQuantity = 1;
        _newLineUnitCost = null;
    }

    private async Task Submit()
    {
        _error = null;
        _message = null;
        _submitting = true;
        try
        {
            foreach (var line in _lines)
            {
                await Api.AddStockMovementAsync(line.PartId, new StockMovementUpsertDto
                {
                    MovementType = PartMovementType.Receipt,
                    Quantity = line.Quantity,
                    UnitCost = line.UnitCost,
                    Date = _date,
                    SupplierName = _supplierName,
                    Notes = _notes
                });
            }

            _message = $"Receipt recorded: {_lines.Count} line(s).";
            _lines.Clear();
        }
        catch (Exception ex)
        {
            _error = $"Failed to submit receipt: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private string PartLabel(int partId) =>
        _parts?.FirstOrDefault(p => p.Id == partId) is { } p ? $"{p.PartNumber} — {p.Name}" : $"#{partId}";
}
