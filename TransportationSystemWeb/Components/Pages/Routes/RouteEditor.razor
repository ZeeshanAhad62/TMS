@page "/routes/new"
@page "/routes/{Id:int}/edit"
@attribute [Authorize]
@inject FleetApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(IsNew ? "Add Route" : "Edit Route") - Routes &amp; Rates</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">
            @if (IsNew)
            {
                <text>Add Route</text>
            }
            else
            {
                <span class="font-monospace">@_detail?.RouteCode</span>
                <text> &mdash; @(_model.Origin) &rarr; @(_model.Destination)</text>
            }
        </h2>
        <div class="text-muted small">Routes &amp; Rates &rsaquo; Route Master</div>
    </div>
    <a class="btn btn-outline-secondary" href="/routes"><i class="bi bi-arrow-left me-1"></i>Back to list</a>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
@if (_message is not null)
{
    <div class="alert alert-success">@_message</div>
}

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <div class="card"><div class="card-body">
            <h5 class="card-title">Route Details</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Route Code</label>
                    <input class="form-control" value="@(IsNew ? "(auto-generated on save)" : _detail?.RouteCode)" disabled />
                </div>
                <div class="col-md-8">
                    <label class="form-label">Name (optional)</label>
                    <InputText class="form-control" @bind-Value="_model.Name" placeholder="e.g. KHI–LHE Express" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Origin *</label>
                    <InputText class="form-control" @bind-Value="_model.Origin" />
                    <ValidationMessage For="() => _model.Origin" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Destination *</label>
                    <InputText class="form-control" @bind-Value="_model.Destination" />
                    <ValidationMessage For="() => _model.Destination" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Distance (km)</label>
                    <InputNumber class="form-control" @bind-Value="_model.DistanceKm" />
                    <div class="form-text">Used for per-km rate contracts.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Est. Duration (hours)</label>
                    <InputNumber class="form-control" @bind-Value="_model.EstimatedDurationHours" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Standard Rate</label>
                    <InputNumber class="form-control" @bind-Value="_model.StandardRate" />
                    <div class="form-text">Default trip revenue when no contract applies.</div>
                </div>

                <div class="col-md-12">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="active" @bind="_model.IsActive" />
                        <label class="form-check-label" for="active">Active</label>
                    </div>
                </div>
                <div class="col-md-12">
                    <label class="form-label">Notes</label>
                    <InputTextArea class="form-control" rows="2" @bind-Value="_model.Notes" />
                </div>
            </div>
        </div></div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>@(IsNew ? "Create Route" : "Save Changes")</button>
            <a class="btn btn-outline-secondary" href="/routes">Cancel</a>
        </div>
    </EditForm>

    @if (!IsNew && _detail is not null)
    {
        <div class="card mt-3"><div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="card-title mb-0">Rate Contracts on this route</h5>
                <a class="btn btn-sm btn-outline-primary" href="/rate-contracts/new?routeId=@_detail.Id">
                    <i class="bi bi-plus-lg me-1"></i>Add contract
                </a>
            </div>
            @if (_detail.Contracts.Count == 0)
            {
                <div class="text-muted small">No rate contracts reference this route yet.</div>
            }
            else
            {
                <table class="table table-sm align-middle">
                    <thead><tr><th>Code</th><th>Customer</th><th>Vehicle Type</th><th class="text-end">Rate</th><th>Basis</th><th>Valid</th><th>Now</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var c in _detail.Contracts)
                    {
                        <tr>
                            <td class="font-monospace">@c.ContractCode</td>
                            <td>@c.CustomerName</td>
                            <td>@(c.VehicleType?.ToDisplayName() ?? "Any")</td>
                            <td class="text-end">@c.Rate.ToString("N2")</td>
                            <td>@c.RateBasis.ToDisplayName()</td>
                            <td class="small">@c.ValidFrom.ToString("dd-MMM-yy") – @(c.ValidTo?.ToString("dd-MMM-yy") ?? "open")</td>
                            <td>@(c.IsCurrentlyValid ? "✓" : "—")</td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/rate-contracts/@c.Id/edit"><i class="bi bi-pencil-square"></i></a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div></div>
    }
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;
    private bool _loading = true;
    private string? _error;
    private string? _message;

    private RouteUpsertDto _model = new() { IsActive = true };
    private RouteDetailDto? _detail;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            if (Id.HasValue)
            {
                _detail = await Api.GetRouteAsync(Id.Value);
                if (_detail is null) _error = "Route not found.";
                else _model = _detail;
            }
            else
            {
                _detail = null;
                _model = new RouteUpsertDto { IsActive = true };
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load route: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Save()
    {
        _error = null;
        _message = null;
        try
        {
            if (IsNew)
            {
                var created = await Api.CreateRouteAsync(_model);
                Nav.NavigateTo($"/routes/{created.Id}/edit");
            }
            else
            {
                await Api.UpdateRouteAsync(Id!.Value, _model);
                _message = "Changes saved.";
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to save route: {ex.Message}";
        }
    }
}
